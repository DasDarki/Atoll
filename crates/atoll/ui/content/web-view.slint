import { Theme } from "../theme.slint";
import { BrowserState } from "../state.slint";
import { WebSurface } from "web-surface.slint";

export component WebView inherits Rectangle {
    out property <bool> focused: surface.focused;

    public function focus-page() {
        surface.focus-surface();
    }

    surface := WebSurface {
        width: root.width;
        height: root.height;
        frame: BrowserState.page-frame;
        popup-frame: BrowserState.popup-frame;
        popup-visible: BrowserState.popup-visible;
        popup-x: BrowserState.popup-x;
        popup-y: BrowserState.popup-y;
        cursor: BrowserState.cursor;
        pointer(pointer) => { BrowserState.web-pointer(pointer); }
        scroll(scroll) => { return BrowserState.web-scroll(scroll); }
        hover(inside, x, y) => { BrowserState.web-hover(inside, x, y); }
        resized(width, height) => { BrowserState.web-resized(width, height); }
        focus-changed(focused) => { BrowserState.web-focus-changed(focused); }
    }

    if BrowserState.tooltip != "" && surface.hovered : Rectangle {
        x: min(surface.pointer-x + 12px, parent.width - self.width - 4px);
        y: min(surface.pointer-y + 20px, parent.height - self.height - 4px);
        width: min(tip.preferred-width + 18px, 420px);
        height: tip.preferred-height + 12px;
        border-radius: Theme.radius-small;
        background: #10111bf2;
        border-width: 1px;
        border-color: Theme.border-strong;
        tip := Text {
            x: 9px;
            width: parent.width - 18px;
            text: BrowserState.tooltip;
            color: Theme.text;
            font-size: Theme.font-small + 1px;
            wrap: word-wrap;
        }
    }

    if BrowserState.status-text != "" : Rectangle {
        x: 8px;
        y: parent.height - self.height - 8px;
        width: min(status.preferred-width + 20px, parent.width * 0.6);
        height: 24px;
        border-radius: Theme.radius-small;
        background: #10111bee;
        border-width: 1px;
        border-color: Theme.border-strong;
        status := Text {
            x: 10px;
            width: parent.width - 20px;
            text: BrowserState.status-text;
            color: Theme.text-muted;
            font-size: Theme.font-small + 1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if BrowserState.crashed : Rectangle {
        background: Theme.background;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "Diese Seite ist abgestürzt.";
                color: Theme.text;
                font-size: Theme.font-large + 3px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Zum erneuten Laden klicken oder F5 drücken.";
                color: Theme.text-muted;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { BrowserState.reload(false); }
        }
    }
}

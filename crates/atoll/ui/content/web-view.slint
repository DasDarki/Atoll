import { Theme } from "../theme.slint";
import { BrowserState } from "../state.slint";
import { WebSurface } from "web-surface.slint";

export component WebView inherits Rectangle {
    out property <bool> focused: surface.focused;

    public function focus-page() {
        surface.focus-surface();
    }

    surface := WebSurface {
        width: root.width;
        height: root.height;
        frame: BrowserState.page-frame;
        popup-frame: BrowserState.popup-frame;
        popup-visible: BrowserState.popup-visible;
        popup-x: BrowserState.popup-x;
        popup-y: BrowserState.popup-y;
        cursor: BrowserState.cursor;
        pointer(pointer) => { BrowserState.web-pointer(pointer); }
        scroll(scroll) => { return BrowserState.web-scroll(scroll); }
        hover(inside, x, y) => { BrowserState.web-hover(inside, x, y); }
        resized(width, height) => { BrowserState.web-resized(width, height); }
        focus-changed(focused) => { BrowserState.web-focus-changed(focused); }
    }

    // Where the tip appeared, which is where it stays: one that follows the pointer around
    // sticks to it when a page forgets to take its tip back.
    property <length> tip-x;
    property <length> tip-y;
    property <bool> tip-shown;
    property <string> tip-text: BrowserState.tooltip;
    changed tip-text => {
        self.tip-x = surface.pointer-x;
        self.tip-y = surface.pointer-y;
        self.tip-shown = self.tip-text != "";
    }

    // The tip belongs to the place it appeared over. Once the pointer has left that place, it is
    // gone, whether the page says so or not.
    property <bool> pointer-at-the-tip: abs(surface.pointer-x - root.tip-x) < 56px
        && abs(surface.pointer-y - root.tip-y) < 40px;
    changed pointer-at-the-tip => {
        if (!self.pointer-at-the-tip) {
            self.tip-shown = false;
        }
    }

    Timer {
        // Nothing stays next to the pointer forever.
        interval: 10s;
        running: root.tip-shown;
        triggered => { root.tip-shown = false; }
    }

    if root.tip-shown && root.tip-text != "" && surface.hovered : Rectangle {
        x: min(root.tip-x + 12px, parent.width - self.width - 4px);
        y: min(root.tip-y + 20px, parent.height - self.height - 4px);
        width: min(tip.preferred-width + 18px, 420px);
        height: tip.preferred-height + 12px;
        border-radius: Theme.radius-small;
        background: #10111bf2;
        border-width: 1px;
        border-color: Theme.border-strong;
        tip := Text {
            x: 9px;
            width: parent.width - 18px;
            text: root.tip-text;
            color: Theme.text;
            font-size: Theme.font-small + 1px;
            wrap: word-wrap;
        }
    }

    if BrowserState.status-text != "" : Rectangle {
        x: 8px;
        y: parent.height - self.height - 8px;
        width: min(status.preferred-width + 20px, parent.width * 0.6);
        height: 24px;
        border-radius: Theme.radius-small;
        background: #10111bee;
        border-width: 1px;
        border-color: Theme.border-strong;
        status := Text {
            x: 10px;
            width: parent.width - 20px;
            text: BrowserState.status-text;
            color: Theme.text-muted;
            font-size: Theme.font-small + 1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if BrowserState.crashed : Rectangle {
        background: Theme.background;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: @tr("Diese Seite ist abgestürzt.");
                color: Theme.text;
                font-size: Theme.font-large + 3px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("Zum erneuten Laden klicken oder F5 drücken.");
                color: Theme.text-muted;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { BrowserState.reload(false); }
        }
    }
}

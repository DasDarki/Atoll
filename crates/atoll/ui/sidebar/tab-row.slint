import { Theme } from "../theme.slint";
import { SidebarState } from "../state.slint";
import { SidebarRow, TabLoadState } from "../structs.slint";
import { IconButton } from "../widgets/icon-button.slint";

export component TabRow inherits Rectangle {
    in property <length> island-drag-y;
    in property <length> tab-drag-y;
    in property <SidebarRow> entry;
    callback tab-drag-moved(length);

    property <length> press-x;
    property <length> press-y;
    property <bool> dragging;
    property <bool> control-held;
    property <bool> shift-held;
    property <length> top: self.absolute-position.y;
    // While an island is dragged over the tabs of an island, it would land below that island.
    property <bool> island-target: SidebarState.island-drag-id != -1
        && SidebarState.island-drag-id != root.entry.island-id
        && root.island-drag-y >= root.top && root.island-drag-y < root.top + root.height;
    // Which half of this row a dragged tab stands over: -1 none, 0 above it, 1 below it.
    property <int> tab-drag-half: SidebarState.tab-drag-id == -2
        || root.tab-drag-y < root.top || root.tab-drag-y >= root.top + root.height ? -1
        : root.tab-drag-y < root.top + root.height / 2 ? 0 : 1;

    changed island-target => {
        if (self.island-target) {
            SidebarState.island-drag-hover(root.entry.island-id, true);
        }
    }

    changed tab-drag-half => {
        if (self.tab-drag-half >= 0) {
            SidebarState.tab-drag-over-tab(root.entry.tab-id, self.tab-drag-half == 1);
        }
    }

    height: 32px;
    opacity: root.dragging || (root.entry.picked && SidebarState.tab-drag-id != -2) ? 0.5 : 1.0;

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Neu laden");
                activated => { SidebarState.tab-action(root.entry.tab-id, "reload"); }
            }
            MenuItem {
                title: @tr("Schlafen legen");
                enabled: root.entry.state == TabLoadState.frozen;
                activated => { SidebarState.tab-action(root.entry.tab-id, "sleep"); }
            }
            MenuItem {
                title: root.entry.pinned ? @tr("Nicht mehr anpinnen") : @tr("Anpinnen");
                activated => { SidebarState.tab-action(root.entry.tab-id, "pin"); }
            }
            MenuItem {
                title: @tr("Duplizieren");
                activated => { SidebarState.tab-action(root.entry.tab-id, "duplicate"); }
            }
            MenuItem {
                title: @tr("Adresse kopieren");
                activated => { SidebarState.tab-action(root.entry.tab-id, "copy-url"); }
            }
            MenuItem {
                title: @tr("Als Lesezeichen speichern");
                activated => { SidebarState.tab-action(root.entry.tab-id, "bookmark"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("In neue Insel verschieben");
                activated => { SidebarState.tab-action(root.entry.tab-id, "new-island"); }
            }
            Menu {
                title: @tr("In Insel verschieben");
                for target in SidebarState.island-targets : MenuItem {
                    title: target.name;
                    enabled: target.id != root.entry.island-id;
                    activated => { SidebarState.move-tab-to-island(root.entry.tab-id, target.id); }
                }
            }
            MenuItem {
                title: @tr("In neues Fenster verschieben");
                activated => { SidebarState.tab-action(root.entry.tab-id, "new-window"); }
            }
            Menu {
                title: @tr("In Fenster verschieben");
                enabled: SidebarState.window-targets.length > 0;
                for target in SidebarState.window-targets : MenuItem {
                    title: target.name;
                    activated => { SidebarState.move-tab-to-workspace(root.entry.tab-id, target.id); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Tab schließen");
                activated => { SidebarState.close-tab(root.entry.tab-id); }
            }
        }

        touch := TouchArea {
            mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.press-x = self.mouse-x;
                    root.press-y = self.mouse-y;
                    root.dragging = false;
                    root.control-held = event.modifiers.control;
                    root.shift-held = event.modifiers.shift;
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragging) {
                    root.dragging = false;
                    SidebarState.tab-drag-released(root.entry.tab-id, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                    SidebarState.close-tab(root.entry.tab-id);
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            moved => {
                if (self.pressed && !root.dragging && (abs(self.mouse-x - root.press-x) > 8px || abs(self.mouse-y - root.press-y) > 8px)) {
                    root.dragging = true;
                    SidebarState.hovering = false;
                    SidebarState.tab-drag-started(root.entry.tab-id);
                }
                if (root.dragging) {
                    root.tab-drag-moved(root.top + self.mouse-y);
                }
            }
            clicked => {
                SidebarState.hovering = false;
                SidebarState.tab-clicked(root.entry.tab-id, root.control-held, root.shift-held);
            }
            changed has-hover => {
                if (self.has-hover) {
                    SidebarState.hover-tab = root.entry.tab-id;
                    SidebarState.hover-title = root.entry.title;
                    SidebarState.hover-url = root.entry.url;
                    SidebarState.hover-detail = root.entry.state == TabLoadState.sleeping ? @tr("Schläft, wird beim Öffnen geladen")
                        : root.entry.state == TabLoadState.frozen ? @tr("Eingefroren im Hintergrund") : "";
                    SidebarState.hover-y = root.absolute-position.y;
                    SidebarState.hovering = true;
                } else if (SidebarState.hover-tab == root.entry.tab-id) {
                    SidebarState.hovering = false;
                }
            }
        }
    }

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        border-radius: Theme.radius-small;
        background: root.entry.active ? Theme.selected
            : root.entry.picked ? Theme.accent.transparentize(0.86)
            : touch.has-hover || close.hovered ? Theme.hover : transparent;
        border-width: root.entry.picked ? 1px : 0px;
        border-color: Theme.accent.transparentize(0.5);
        animate background { duration: 100ms; }

        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: root.entry.active ? 16px : 0px;
            border-radius: 2px;
            background: Theme.accent-gradient;
            animate height { duration: 150ms; easing: ease-out; }
        }

        HorizontalLayout {
            padding-left: 22px;
            padding-right: 4px;
            spacing: 8px;

            Rectangle {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                opacity: root.entry.state == TabLoadState.sleeping ? 0.55 : 1.0;

                if root.entry.private : Image {
                    source: root.entry.through-tor
                        ? @image-url("../icons/shield.svg")
                        : @image-url("../icons/incognito.svg");
                    width: 15px;
                    height: 15px;
                    colorize: root.entry.through-tor ? Theme.accent : Theme.accent-cyan;
                }
                if !root.entry.private && root.entry.has-icon : Image {
                    source: root.entry.icon;
                    width: 16px;
                    height: 16px;
                }
                if !root.entry.private && !root.entry.has-icon : Image {
                    source: @image-url("../icons/globe.svg");
                    width: 14px;
                    height: 14px;
                    colorize: Theme.text-faint;
                }
            }

            Text {
                text: root.entry.title;
                color: root.entry.active ? Theme.text : root.entry.state == TabLoadState.sleeping ? Theme.text-muted : #d3d6ea;
                font-size: Theme.font-normal;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.entry.pinned : Image {
                source: @image-url("../icons/pin.svg");
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                colorize: Theme.text-faint;
            }

            if root.entry.loading : Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: Theme.accent-cyan;
            }

            if root.entry.state == TabLoadState.frozen && !root.entry.loading : Rectangle {
                width: 5px;
                height: 5px;
                y: (parent.height - self.height) / 2;
                border-radius: 2.5px;
                background: Theme.text-faint;
            }

            close := IconButton {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                icon-size: 12px;
                icon: @image-url("../icons/close.svg");
                opacity: touch.has-hover || self.hovered || root.entry.active ? 1 : 0;
                clicked => { SidebarState.close-tab(root.entry.tab-id); }
            }
        }
    }
}

import { Theme } from "../theme.slint";
import { SidebarState } from "../state.slint";
import { SidebarRow } from "../structs.slint";
import { IconButton } from "../widgets/icon-button.slint";

export component IslandHeader inherits Rectangle {
    in property <SidebarRow> entry;
    in property <length> drag-y;
    callback drag-moved(length);

    property <bool> dragged;
    property <length> top: self.absolute-position.y;
    property <bool> drag-running: SidebarState.island-drag-id != -1;
    property <int> drag-mode: !root.drag-running || SidebarState.island-drag-id == root.entry.island-id
        || root.drag-y < root.top || root.drag-y >= root.top + root.height ? -1
        : root.drag-y < root.top + root.height / 2 ? 0 : 1;

    changed drag-mode => {
        if (self.drag-mode >= 0) {
            SidebarState.island-drag-hover(root.entry.island-id, self.drag-mode == 1);
        }
    }

    height: 34px;
    opacity: SidebarState.island-drag-id == root.entry.island-id ? 0.45 : 1.0;

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Neuer Tab in dieser Insel");
                activated => { SidebarState.island-action(root.entry.island-id, "new-tab"); }
            }
            MenuItem {
                title: @tr("Umbenennen");
                activated => { SidebarState.island-action(root.entry.island-id, "rename"); }
            }
            Menu {
                title: @tr("Farbe");
                for color[index] in Theme.island-colors : MenuItem {
                    title: [@tr("Violett"), @tr("Blau"), @tr("Cyan"), @tr("Türkis"), @tr("Grün"), @tr("Bernstein"), @tr("Rosa"), @tr("Schiefer")][index];
                    activated => { SidebarState.set-island-color(root.entry.island-id, index); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Alle Tabs schlafen legen");
                activated => { SidebarState.island-action(root.entry.island-id, "sleep"); }
            }
            MenuItem {
                title: @tr("Alle Tabs als Lesezeichen speichern");
                activated => { SidebarState.island-action(root.entry.island-id, "bookmark"); }
            }
            MenuItem {
                title: @tr("Als Liste exportieren");
                activated => { SidebarState.island-action(root.entry.island-id, "export"); }
            }
            MenuItem {
                title: @tr("Nach oben");
                activated => { SidebarState.island-action(root.entry.island-id, "move-up"); }
            }
            MenuItem {
                title: @tr("Nach unten");
                activated => { SidebarState.island-action(root.entry.island-id, "move-down"); }
            }
            MenuItem {
                title: @tr("Nach ganz oben");
                activated => { SidebarState.island-action(root.entry.island-id, "move-top"); }
            }
            MenuItem {
                title: @tr("Nach ganz unten");
                activated => { SidebarState.island-action(root.entry.island-id, "move-bottom"); }
            }
            MenuItem {
                title: @tr("In neues Fenster verschieben");
                activated => { SidebarState.island-action(root.entry.island-id, "new-window"); }
            }
            Menu {
                title: @tr("In Workspace verschieben");
                for workspace in SidebarState.workspaces : MenuItem {
                    title: workspace.name;
                    enabled: !workspace.active;
                    activated => { SidebarState.move-island-to-workspace(root.entry.island-id, workspace.id); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Archivieren");
                activated => { SidebarState.island-action(root.entry.island-id, "archive"); }
            }
            MenuItem {
                title: @tr("Insel löschen");
                activated => { SidebarState.island-action(root.entry.island-id, "delete"); }
            }
        }

        touch := TouchArea {
            mouse-cursor: root.dragged ? MouseCursor.grabbing : MouseCursor.pointer;
            clicked => {
                if (!root.dragged) {
                    SidebarState.toggle-island(root.entry.island-id);
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        root.dragged = false;
                    } else if (event.kind == PointerEventKind.up && root.dragged) {
                        SidebarState.island-drag-ended();
                        root.dragged = false;
                    }
                    return;
                }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
            moved => {
                if (!root.dragged && self.pressed && abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.dragged = true;
                    SidebarState.hovering = false;
                    SidebarState.island-drag-started(root.entry.island-id);
                }
                if (root.dragged) {
                    root.drag-moved(root.top + self.mouse-y);
                }
            }
        }
    }

    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;

        Image {
            source: root.entry.collapsed ? @image-url("../icons/chevron-right.svg") : @image-url("../icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.text-faint;
        }

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.entry.color;
        }

        Text {
            text: root.entry.title;
            color: Theme.text;
            font-size: Theme.font-small + 1px;
            font-weight: 700;
            letter-spacing: 0.3px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.entry.idle : IconButton {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            icon-size: 12px;
            icon: @image-url("../icons/archive.svg");
            tint: Theme.text-faint;
            clicked => { SidebarState.open-archive(); }
        }

        Text {
            text: root.entry.count;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            visible: !touch.has-hover && !more.hovered && !add.hovered;
        }

        add := IconButton {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/plus.svg");
            opacity: touch.has-hover || self.hovered || more.hovered ? 1 : 0;
            clicked => { SidebarState.island-action(root.entry.island-id, "new-tab"); }
        }

        more := IconButton {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/more.svg");
            opacity: touch.has-hover || self.hovered || add.hovered ? 1 : 0;
            clicked => { menu.show({ x: self.x, y: self.y + self.height }); }
        }
    }
}

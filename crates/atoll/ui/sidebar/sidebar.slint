import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserState, SidebarState } from "../state.slint";
import { RowKind } from "../structs.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { WorkspaceBar } from "workspace-bar.slint";
import { IslandHeader } from "island-header.slint";
import { TabRow } from "tab-row.slint";

component FooterButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> badge;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;
        alignment: center;

        Image {
            source: root.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: touch.has-hover ? Theme.text : Theme.text-muted;
        }

        Text {
            text: root.label;
            color: touch.has-hover ? Theme.text : Theme.text-muted;
            font-size: Theme.font-small + 0.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.badge : Rectangle {
        x: parent.width - 10px;
        y: 5px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent-cyan;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    property <length> island-drag-y;
    property <length> tab-drag-y;
    property <bool> hidden: BrowserState.fullscreen;
    property <length> scroll-before-hiding;
    property <length> height-before-hiding;
    property <bool> scroll-to-restore;
    changed hidden => {
        if (self.hidden) {
            self.scroll-before-hiding = tab-list.content-y;
            self.height-before-hiding = self.height;
        } else if (self.height == self.height-before-hiding) {
            tab-list.content-y = self.scroll-before-hiding;
        } else {
            self.scroll-to-restore = true;
        }
    }
    changed height => {
        if (self.scroll-to-restore && !self.hidden) {
            self.scroll-to-restore = false;
            tab-list.content-y = self.scroll-before-hiding;
        }
    }

    width: Theme.sidebar-width;
    background: Theme.chrome;

    // Around everything: whoever leaves the sidebar takes the preview card with them. A row that
    // is replaced while it is being pointed at cannot report that itself any more, and the rows
    // are replaced whenever anything about a tab changes, which happens a lot right after
    // starting up. The area around them stays, so that is the one that is asked.
    leaving := TouchArea {
        mouse-cursor: default;
        changed has-hover => {
            if (!self.has-hover) {
                SidebarState.hovering = false;
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            WorkspaceBar { }

            tab-list := ListView {
                vertical-stretch: 1;
                for row[index] in SidebarState.rows : Rectangle {
                    height: row.kind == RowKind.island ? 34px : 32px;
                    if row.kind == RowKind.island : IslandHeader {
                        entry: row;
                        drag-y: root.island-drag-y;
                        tab-drag-y: root.tab-drag-y;
                        drag-moved(y) => { root.island-drag-y = y; }
                    }
                    if row.kind == RowKind.tab : TabRow {
                        entry: row;
                        island-drag-y: root.island-drag-y;
                        tab-drag-y: root.tab-drag-y;
                        tab-drag-moved(y) => { root.tab-drag-y = y; }
                    }
                    if row.kind == RowKind.island && SidebarState.island-drop-before == row.island-id : Rectangle {
                        y: 0;
                        height: 2px;
                        background: Theme.accent;
                    }
                    if index == SidebarState.rows.length - 1 && SidebarState.island-drop-before == -1 : Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Theme.accent;
                    }
                    if SidebarState.tab-drop-row == index : Rectangle {
                        y: 0;
                        height: 2px;
                        background: Theme.accent-cyan;
                    }
                    if SidebarState.tab-drop-row == index + 1 && index == SidebarState.rows.length - 1 : Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Theme.accent-cyan;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding: 6px;
                spacing: 0px;

                FooterButton {
                    icon: @image-url("../icons/island.svg");
                    label: @tr("Insel");
                    horizontal-stretch: 1;
                    clicked => { SidebarState.create-island(); }
                }
                FooterButton {
                    icon: @image-url("../icons/archive.svg");
                    label: @tr("Archiv");
                    badge: SidebarState.archive-suggestion;
                    horizontal-stretch: 1;
                    clicked => { SidebarState.open-archive(); }
                }
                FooterButton {
                    icon: @image-url("../icons/import.svg");
                    label: @tr("Import");
                    horizontal-stretch: 1;
                    clicked => { SidebarState.open-import(); }
                }
                FooterButton {
                    icon: @image-url("../icons/export.svg");
                    label: @tr("Export");
                    horizontal-stretch: 1;
                    clicked => { SidebarState.open-export(); }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

import { Theme } from "../theme.slint";
import { BrowserState, SidebarState } from "../state.slint";
import { WorkspaceItem } from "../structs.slint";
import { IconButton } from "../widgets/icon-button.slint";

component WorkspaceChip inherits Rectangle {
    in property <WorkspaceItem> item;
    in property <int> index;
    in property <int> total;

    callback reveal(length, length);

    changed x => { if (root.item.active) { root.reveal(root.x, root.width); } }
    changed width => { if (root.item.active) { root.reveal(root.x, root.width); } }
    changed item => { if (root.item.active) { root.reveal(root.x, root.width); } }

    height: 28px;
    border-radius: Theme.radius-small;
    background: root.item.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        label := Text {
            text: root.item.name;
            color: root.item.active ? Theme.text : Theme.text-muted;
            font-size: Theme.font-normal;
            font-weight: root.item.active ? 600 : 400;
            vertical-alignment: center;
        }
        if root.item.open-elsewhere : Rectangle {
            width: 9px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-radius: 1.5px;
            border-color: Theme.text-faint;
        }
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 16px;
        x: 8px;
        border-radius: 1px;
        background: root.item.active ? Theme.accent-gradient : transparent;
    }

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: root.item.open-elsewhere ? "Zum Fenster wechseln" : "In neuem Fenster öffnen";
                enabled: !root.item.active;
                activated => { SidebarState.workspace-action(root.item.id, "open-window"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Umbenennen";
                activated => { SidebarState.workspace-action(root.item.id, "rename"); }
            }
            MenuItem {
                title: "Nach links verschieben";
                enabled: root.index > 0;
                activated => { SidebarState.workspace-action(root.item.id, "move-left"); }
            }
            MenuItem {
                title: "Nach rechts verschieben";
                enabled: root.index < root.total - 1;
                activated => { SidebarState.workspace-action(root.item.id, "move-right"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Workspace löschen";
                enabled: root.total > 1;
                activated => { SidebarState.workspace-action(root.item.id, "delete"); }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { SidebarState.select-workspace(root.item.id); }
            double-clicked => { SidebarState.workspace-action(root.item.id, "rename"); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
}

export component WorkspaceBar inherits Rectangle {
    height: 44px;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                BrowserState.window-drag();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;

        Image {
            source: @image-url("../images/logo-64.png");
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
        }

        strip := Rectangle {
            clip: true;
            horizontal-stretch: 1;
            property <length> offset: 0px;

            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        BrowserState.window-drag();
                    }
                }
                scroll-event(event) => {
                    strip.offset = clamp(strip.offset + event.delta-y + event.delta-x, min(0px, strip.width - chips.preferred-width), 0px);
                    return accept;
                }
            }

            chips := HorizontalLayout {
                x: strip.offset;
                width: self.preferred-width;
                spacing: 2px;
                alignment: start;
                for item[index] in SidebarState.workspaces : WorkspaceChip {
                    y: (strip.height - self.height) / 2;
                    item: item;
                    index: index;
                    total: SidebarState.workspaces.length;
                    reveal(x, width) => {
                        if (x + strip.offset < 0) {
                            strip.offset = -x;
                        } else if (x + width + strip.offset > strip.width) {
                            strip.offset = min(0px, strip.width - x - width);
                        }
                    }
                }
            }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/plus.svg");
            clicked => { SidebarState.create-workspace(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

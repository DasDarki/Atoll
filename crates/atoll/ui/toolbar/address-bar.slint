import { Theme } from "../theme.slint";
import { BrowserState } from "../state.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { PageSecurity } from "../structs.slint";

export component AddressBar inherits Rectangle {
    property <string> address: BrowserState.address;
    out property <bool> editing: input.has-focus;
    out property <length> anchor-x: self.absolute-position.x;
    out property <length> anchor-y: self.absolute-position.y + self.height + 4px;

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    changed address => {
        if (!input.has-focus) {
            input.text = self.address;
        }
    }

    height: 32px;
    border-radius: 16px;
    background: input.has-focus ? Theme.surface-raised : Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border;
    animate border-color, background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: text;
        clicked => {
            if (!input.has-focus) {
                input.focus();
                input.select-all();
            }
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                input.text = BrowserState.address;
                input.clear-focus();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            padding-left: 7px;
            padding-right: 4px;
            spacing: 4px;

            if BrowserState.has-page : Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: shield.pressed ? Theme.pressed : shield.has-hover ? Theme.hover : transparent;

                Image {
                    width: 14px;
                    height: 14px;
                    source: BrowserState.protection-off ? @image-url("../icons/shield-off.svg")
                        : @image-url("../icons/shield.svg");
                    colorize: BrowserState.protection-off ? Theme.text-faint : #8b9dff;
                }

                shield := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { BrowserState.show-shield(); }
                }
            }

            Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: badge.pressed ? Theme.pressed : badge.has-hover && badge.enabled ? Theme.hover : transparent;

                Image {
                    width: 13px;
                    height: 13px;
                    source: BrowserState.security == PageSecurity.secure ? @image-url("../icons/lock.svg")
                        : BrowserState.security == PageSecurity.insecure ? @image-url("../icons/alert.svg")
                        : BrowserState.security == PageSecurity.internal ? @image-url("../icons/info.svg")
                        : @image-url("../icons/search.svg");
                    colorize: BrowserState.security == PageSecurity.secure ? #6ee7b7
                        : BrowserState.security == PageSecurity.insecure ? #fbbf24
                        : Theme.text-faint;
                }

                badge := TouchArea {
                    enabled: BrowserState.security != PageSecurity.none;
                    mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.text;
                    clicked => { BrowserState.show-site-info(); }
                }
            }

            if BrowserState.vpn-state != 0 : Rectangle {
                width: vpn-label.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: BrowserState.vpn-state == 2 ? #10b98126
                    : BrowserState.vpn-state == 3 ? Theme.danger.with-alpha(0.18)
                    : Theme.hover;

                vpn-label := Text {
                    text: @tr("VPN");
                    color: BrowserState.vpn-state == 2 ? #34d399
                        : BrowserState.vpn-state == 3 ? Theme.danger
                        : Theme.text-faint;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { BrowserState.show-shield(); }
                }
            }

            if BrowserState.private-tab : Rectangle {
                width: label.preferred-width + 14px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: BrowserState.tor-tab ? Theme.accent.transparentize(0.82) : Theme.accent-cyan.transparentize(0.85);

                label := Text {
                    text: BrowserState.tor-tab ? @tr("Tor") : @tr("Privat");
                    color: BrowserState.tor-tab ? Theme.accent : Theme.accent-cyan;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if BrowserState.also-open != "" : Rectangle {
                width: min(also-open-label.preferred-width + 16px, 190px);
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: also-open-touch.pressed ? Theme.pressed
                    : also-open-touch.has-hover ? Theme.accent.transparentize(0.7)
                    : Theme.accent.transparentize(0.82);

                also-open-label := Text {
                    text: BrowserState.also-open;
                    color: Theme.accent;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                also-open-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { BrowserState.show-other-tab(); }
                }
            }

            Rectangle {
                clip: true;
                horizontal-stretch: 1;

                Text {
                    x: 0;
                    width: parent.width;
                    text: @tr("Suchen oder Adresse eingeben");
                    visible: input.text == "";
                    color: Theme.text-faint;
                    font-size: Theme.font-normal;
                    vertical-alignment: center;
                }

                input := TextInput {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text: BrowserState.address;
                    color: self.has-focus ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-normal;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: #7c6cff66;
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow && BrowserState.suggestions-visible) {
                            self.text = BrowserState.suggestion-move(1);
                            return accept;
                        }
                        if (event.text == Key.UpArrow && BrowserState.suggestions-visible) {
                            self.text = BrowserState.suggestion-move(-1);
                            return accept;
                        }
                        if (event.text == Key.Escape && BrowserState.suggestions-visible) {
                            BrowserState.suggestions-dismissed();
                            return accept;
                        }
                        return reject;
                    }
                    edited => {
                        let completion = BrowserState.address-edited(0, self.text);
                        if (completion.text != self.text) {
                            self.text = completion.text;
                            self.set-selection-offsets(completion.selection-start, completion.selection-end);
                        }
                    }
                    accepted => {
                        BrowserState.address-submitted(0, self.text);
                        self.clear-focus();
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            self.text = BrowserState.address;
                            BrowserState.suggestions-dismissed();
                        }
                    }
                }
            }

            if BrowserState.page-video : IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                icon: @image-url("../icons/download.svg");
                tint: Theme.text-faint;
                clicked => { BrowserState.download-video(); }
            }

            if BrowserState.login-form : IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                icon: @image-url("../icons/key.svg");
                tint: Theme.accent;
                clicked => { BrowserState.show-passwords(); }
            }

            if BrowserState.has-page : IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                icon: BrowserState.page-bookmarked ? @image-url("../icons/star-filled.svg") : @image-url("../icons/star.svg");
                tint: BrowserState.page-bookmarked ? #fbbf24 : Theme.text-faint;
                clicked => { BrowserState.toggle-bookmark(); }
            }
        }
    }
}

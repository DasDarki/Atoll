import { Theme } from "../theme.slint";
import { BrowserState } from "../state.slint";
import { BookmarkItem } from "../structs.slint";

component BookmarkChip inherits Rectangle {
    in property <BookmarkItem> item;
    in property <int> drag-id: -1;
    in property <length> drag-x;
    in property <int> drop-target: -1;
    in property <int> drop-mode;
    callback drag-started(int);
    callback drag-moved(length, length);
    callback drag-ended();
    callback hover-target(int, int);

    property <bool> dragged;
    property <length> left: self.absolute-position.x;
    property <int> drag-mode: root.drag-id == -1 || root.drag-id == root.item.id
        || root.drag-x < root.left || root.drag-x >= root.left + root.width ? -1
        : root.item.is-folder && root.drag-x > root.left + root.width * 0.25 && root.drag-x < root.left + root.width * 0.75 ? 2
        : root.drag-x < root.left + root.width / 2 ? 0 : 1;
    property <bool> is-target: root.drag-id != -1 && root.drop-target == root.item.id;

    changed drag-mode => {
        if (self.drag-mode >= 0) {
            root.hover-target(root.item.id, self.drag-mode);
        }
    }

    height: 26px;
    width: min(layout.preferred-width, 200px);
    border-radius: Theme.radius-small;
    opacity: root.drag-id == root.item.id ? 0.45 : 1.0;
    background: root.is-target && root.drop-mode == 2 ? Theme.selected
        : touch.pressed && root.drag-id == -1 ? Theme.pressed
        : touch.has-hover && root.drag-id == -1 ? Theme.hover : transparent;
    border-width: root.is-target && root.drop-mode == 2 ? 1px : 0px;
    border-color: Theme.accent;

    menu := ContextMenuArea {
        Menu {
            if !root.item.is-folder : MenuItem {
                title: "Öffnen";
                activated => { BrowserState.open-bookmark(root.item.id, false); }
            }
            if !root.item.is-folder : MenuItem {
                title: "In neuem Tab öffnen";
                activated => { BrowserState.open-bookmark(root.item.id, true); }
            }
            if root.item.is-folder : MenuItem {
                title: "Alle in neuen Tabs öffnen";
                activated => { BrowserState.bookmark-action(root.item.id, "open-all"); }
            }
            MenuItem {
                title: root.item.is-folder ? "Umbenennen" : "Bearbeiten";
                activated => { BrowserState.bookmark-action(root.item.id, "edit"); }
            }
            if root.item.is-folder : MenuItem {
                title: "Neuer Ordner darin…";
                activated => { BrowserState.bookmark-action(root.item.id, "new-folder"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Löschen";
                activated => { BrowserState.bookmark-action(root.item.id, "delete"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Neuer Ordner…";
                activated => { BrowserState.menu-action("new-bookmark-folder"); }
            }
            MenuItem {
                title: "Lesezeichen verwalten";
                activated => { BrowserState.bookmark-action(root.item.id, "manage"); }
            }
        }

        touch := TouchArea {
            mouse-cursor: root.drag-id == -1 ? MouseCursor.pointer : MouseCursor.grabbing;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        root.dragged = false;
                    } else if (event.kind == PointerEventKind.up && root.dragged) {
                        root.drag-ended();
                    }
                    return;
                }
                if (event.kind != PointerEventKind.up) {
                    return;
                }
                if (event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                } else if (event.button == PointerEventButton.middle && !root.item.is-folder) {
                    BrowserState.open-bookmark(root.item.id, true);
                }
            }
            moved => {
                if (!root.dragged && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                    root.dragged = true;
                    root.drag-started(root.item.id);
                }
                if (root.dragged) {
                    root.drag-moved(root.left + self.mouse-x, self.mouse-y);
                }
            }
            clicked => {
                if (root.dragged) {
                    return;
                }
                if (root.item.is-folder) {
                    BrowserState.open-bookmark-folder(root.item.id, root.absolute-position.x, root.absolute-position.y + root.height + 2px);
                } else {
                    BrowserState.open-bookmark(root.item.id, false);
                }
            }
        }
    }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        if root.item.has-icon : Image {
            source: root.item.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        if !root.item.has-icon : Image {
            source: root.item.is-folder ? @image-url("../icons/folder.svg") : @image-url("../icons/globe.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: root.item.is-folder ? #fbbf24 : Theme.text-faint;
        }
        Text {
            text: root.item.title;
            color: Theme.text-muted;
            font-size: Theme.font-small + 1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.is-target && root.drop-mode != 2 : Rectangle {
        x: root.drop-mode == 0 ? -2px : root.width;
        y: 3px;
        width: 2px;
        height: root.height - 6px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

export component BookmarksBar inherits Rectangle {
    height: 32px;
    background: Theme.chrome;
    clip: true;

    property <int> drag-id: -1;
    property <length> drag-x;
    property <bool> drag-inside;
    property <int> drop-target: -1;
    property <int> drop-mode;

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Seite als Lesezeichen speichern";
                enabled: BrowserState.has-page;
                activated => { BrowserState.menu-action("bookmark"); }
            }
            MenuItem {
                title: "Neuer Ordner…";
                activated => { BrowserState.menu-action("new-bookmark-folder"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Lesezeichen verwalten";
                activated => { BrowserState.menu-action("bookmarks"); }
            }
            MenuItem {
                title: "Lesezeichenleiste ausblenden";
                activated => { BrowserState.menu-action("bookmarks-bar"); }
            }
        }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;
        alignment: start;

        for item in BrowserState.bookmarks-bar : BookmarkChip {
            y: (parent.height - self.height) / 2;
            item: item;
            drag-id: root.drag-id;
            drag-x: root.drag-x;
            drop-target: root.drop-target;
            drop-mode: root.drop-mode;
            drag-started(id) => {
                root.drag-id = id;
                root.drop-target = -1;
                root.drag-inside = true;
            }
            drag-moved(x, y) => {
                root.drag-x = x;
                root.drag-inside = y > -24px && y < root.height + 24px;
            }
            hover-target(id, mode) => {
                root.drop-target = id;
                root.drop-mode = mode;
            }
            drag-ended => {
                if (root.drop-target != -1 && root.drag-inside) {
                    BrowserState.bookmark-dropped(root.drag-id, root.drop-target, root.drop-mode);
                }
                root.drag-id = -1;
                root.drop-target = -1;
            }
        }

        if BrowserState.bookmarks-bar.length == 0 : Text {
            text: "Lesezeichen mit Strg+D oder dem Stern in der Adressleiste hinzufügen";
            color: Theme.text-faint;
            font-size: Theme.font-small + 1px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

import { Theme } from "../theme.slint";
import { BrowserState, OverlayState, SidebarState } from "../state.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { WindowButton } from "../widgets/window-button.slint";
import { AddressBar } from "address-bar.slint";

export component Toolbar inherits Rectangle {
    height: Theme.toolbar-height;
    background: Theme.chrome;

    out property <length> address-x: address.anchor-x;
    out property <length> address-y: address.anchor-y;
    out property <length> address-width: address.width;

    public function focus-address() {
        address.focus-and-select();
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                BrowserState.window-drag();
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        spacing: 4px;
        alignment: stretch;

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/sidebar.svg");
            active: !SidebarState.visible;
            clicked => { BrowserState.toggle-sidebar(); }
        }

        Rectangle { width: 4px; }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/arrow-left.svg");
            enabled: BrowserState.can-go-back;
            clicked => { BrowserState.go-back(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/arrow-right.svg");
            enabled: BrowserState.can-go-forward;
            clicked => { BrowserState.go-forward(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: BrowserState.loading ? @image-url("../icons/close.svg") : @image-url("../icons/reload.svg");
            enabled: BrowserState.has-page;
            clicked => {
                if (BrowserState.loading) {
                    BrowserState.stop();
                } else {
                    BrowserState.reload(self.shift-held);
                }
            }
            context-requested(x, y) => {
                if (BrowserState.has-page) {
                    reload-menu.show({ x: self.x + x, y: self.y + y });
                }
            }
        }

        if BrowserState.home-button-visible : IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/home.svg");
            clicked => { BrowserState.go-home(); }
        }

        Rectangle {
            min-width: 6px;
            horizontal-stretch: 1;
        }

        address := AddressBar {
            y: (parent.height - self.height) / 2;
            max-width: 900px;
            horizontal-stretch: 12;
        }

        Rectangle {
            min-width: 6px;
            horizontal-stretch: 1;
        }

        if BrowserState.downloads-button-visible : Rectangle {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;

            IconButton {
                icon: @image-url("../icons/download.svg");
                active: OverlayState.downloads-visible;
                tint: BrowserState.downloads-running ? Theme.accent-cyan : Theme.text-muted;
                clicked => { BrowserState.open-downloads(); }
            }

            if BrowserState.downloads-running : Rectangle {
                x: 7px;
                y: parent.height - 4px;
                width: 16px;
                height: 2px;
                border-radius: 1px;
                background: Theme.border-strong;
                Rectangle {
                    x: 0;
                    width: BrowserState.downloads-progress < 0 ? parent.width : parent.width * BrowserState.downloads-progress;
                    border-radius: 1px;
                    background: Theme.accent-cyan;
                }
            }
        }

        menu-button := IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../icons/more.svg");
            clicked => { menu.show({ x: self.x + self.width - 220px, y: self.y + self.height + 4px }); }
        }

        Rectangle { width: 8px; }

        WindowButton {
            icon: @image-url("../icons/window-minimize.svg");
            clicked => { BrowserState.window-control("minimize"); }
        }
        WindowButton {
            icon: BrowserState.maximized ? @image-url("../icons/window-restore.svg") : @image-url("../icons/window-maximize.svg");
            clicked => { BrowserState.window-control("maximize"); }
        }
        WindowButton {
            icon: @image-url("../icons/close.svg");
            destructive: true;
            clicked => { BrowserState.window-control("close"); }
        }
    }

    reload-menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Neu laden (F5)");
                activated => { BrowserState.reload(false); }
            }
            MenuItem {
                title: @tr("Vollständig neu laden, ohne Cache (Strg+F5)");
                activated => { BrowserState.reload(true); }
            }
        }
    }

    menu := ContextMenuArea {
        enabled: false;
        Menu {
            MenuItem {
                title: @tr("Neuer Tab");
                activated => { BrowserState.menu-action("new-tab"); }
            }
            MenuItem {
                title: @tr("Geschlossenen Tab wiederherstellen");
                activated => { BrowserState.menu-action("reopen-tab"); }
            }
            MenuItem {
                title: @tr("Neues Fenster");
                activated => { BrowserState.menu-action("new-window"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Alle Tabs durchsuchen");
                activated => { BrowserState.menu-action("palette"); }
            }
            MenuItem {
                title: @tr("Befehle");
                activated => { BrowserState.menu-action("commands"); }
            }
            MenuItem {
                title: @tr("Mit 1Password anmelden");
                enabled: BrowserState.has-page;
                activated => { BrowserState.menu-action("passwords"); }
            }
            MenuItem {
                title: @tr("Auf Seite suchen");
                enabled: BrowserState.has-page;
                activated => { BrowserState.menu-action("find"); }
            }
            Menu {
                title: @tr("Zoom");
                MenuItem {
                    title: @tr("Vergrößern");
                    activated => { BrowserState.menu-action("zoom-in"); }
                }
                MenuItem {
                    title: @tr("Verkleinern");
                    activated => { BrowserState.menu-action("zoom-out"); }
                }
                MenuItem {
                    title: @tr("Zurücksetzen");
                    activated => { BrowserState.menu-action("zoom-reset"); }
                }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Lesezeichen");
                MenuItem {
                    title: @tr("Seite als Lesezeichen speichern");
                    enabled: BrowserState.has-page;
                    activated => { BrowserState.menu-action("bookmark"); }
                }
                MenuItem {
                    title: BrowserState.bookmarks-bar-visible ? @tr("Lesezeichenleiste ausblenden") : @tr("Lesezeichenleiste einblenden");
                    activated => { BrowserState.menu-action("bookmarks-bar"); }
                }
                MenuItem {
                    title: @tr("Lesezeichen verwalten");
                    activated => { BrowserState.menu-action("bookmarks"); }
                }
            }
            MenuItem {
                title: SidebarState.visible ? @tr("Sidebar ausblenden") : @tr("Sidebar einblenden");
                activated => { BrowserState.menu-action("sidebar"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("URL-Liste importieren");
                activated => { BrowserState.menu-action("import"); }
            }
            MenuItem {
                title: @tr("URL-Liste exportieren");
                activated => { BrowserState.menu-action("export"); }
            }
            MenuItem {
                title: @tr("Archiv");
                activated => { BrowserState.menu-action("archive"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Downloads");
                activated => { BrowserState.menu-action("downloads"); }
            }
            MenuItem {
                title: @tr("Einstellungen");
                activated => { BrowserState.menu-action("settings"); }
            }
            MenuItem {
                title: @tr("Entwicklertools");
                enabled: BrowserState.has-page;
                activated => { BrowserState.menu-action("devtools"); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Beenden");
                activated => { BrowserState.menu-action("quit"); }
            }
        }
    }

    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: BrowserState.loading ? parent.width * max(0.05, BrowserState.progress) : 0px;
        background: Theme.accent-gradient;
        opacity: BrowserState.loading ? 1 : 0;
        animate width { duration: 180ms; easing: ease-out; }
        animate opacity { duration: 300ms; }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

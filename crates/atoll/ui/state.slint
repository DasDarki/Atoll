export global SettingsState {
    in property <bool> visible;
    in-out property <int> section;

    in-out property <string> start-page;
    in-out property <bool> new-tab-start-page;
    in-out property <bool> home-button;
    in property <[string]> search-engines;
    in-out property <int> search-engine;
    in-out property <string> search-url;
    in property <bool> search-url-valid: true;

    in-out property <bool> sidebar-visible;
    in-out property <bool> bookmarks-bar-visible;
    in-out property <bool> bookmarks-bar-auto-hide;

    in-out property <int> frozen-limit;
    in property <int> max-frozen-limit;
    in-out property <int> archive-suggestion-weeks;
    in property <int> max-archive-suggestion-weeks;
    in-out property <bool> memory-limit-enabled;
    in-out property <int> memory-limit-gb;
    in property <int> max-memory-limit-gb;
    in property <string> memory-usage;
    /// Die Version, die laeuft, und was ueber neuere bekannt ist.
    in property <string> version;
    in property <string> update-status;
    in-out property <bool> update-check;
    callback check-for-updates();
    callback open-release-page();

    in property <string> onepassword-status;
    in-out property <bool> password-autofill;

    in property <string> download-directory;
    in property <bool> download-directory-custom;
    in-out property <bool> download-ask;
    in-out property <bool> download-panel;
    callback choose-download-directory();
    callback reset-download-directory();

    in-out property <bool> adblock-enabled;
    in-out property <int> archive-fallback;
    in-out property <bool> archive-on-missing;
    in-out property <bool> vpn-enabled;
    in-out property <int> vpn-kind;
    in-out property <string> vpn-host;
    in-out property <int> vpn-port;
    in-out property <string> vpn-user;
    in-out property <string> vpn-password;
    in property <string> vpn-config;
    in property <string> vpn-status;
    in property <string> vpn-exceptions;
    callback clear-vpn-exceptions();
    callback choose-vpn-config();

    /// 0 durch Atolls VPN, 1 über ein Gerät des Systems.
    in-out property <int> torrent-route;
    in property <[string]> torrent-devices;
    in-out property <int> torrent-device;
    in-out property <bool> page-text-enabled;
    in-out property <bool> page-text-fields;
    in-out property <bool> page-text-drafts;
    in property <string> page-text-size;
    callback forget-page-texts();

    in-out property <bool> torrent-upload;
    /// 0 fragen, 1 sofort laden, 2 nur die Datei behalten.
    in-out property <int> torrent-files;
    in property <string> torrent-status;
    callback torrent-device-chosen(int);

    in-out property <bool> cookie-banners-hide;
    in-out property <bool> cookie-banners-answer;
    in property <string> cookie-banners-status;
    in property <string> adblock-status;
    in property <bool> adblock-updating;
    in property <string> adblock-exceptions;
    callback update-filter-lists();
    callback clear-adblock-exceptions();

    in property <[string]> languages;
    in-out property <int> language;
    in property <[PluginItem]> plugins;
    in property <string> plugin-directory;
    callback plugin-action(string, string);
    callback install-plugin(string);
    callback open-plugin-folder();

    callback changed(string);
    callback use-current-page();
    callback clear-history();
    callback clear-cookies();
    callback close();
}

export global PanelState {
    in property <bool> visible;
    in property <string> title;
    in-out property <length> size: 360px;
    in property <image> frame;
    in property <image> popup-frame;
    in property <bool> popup-visible;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <WebCursor> cursor;

    callback pointer(WebPointer);
    callback scroll(WebScroll) -> bool;
    callback hover(bool, length, length);
    callback resized(length, length);
    callback focus-changed(bool);
    callback close();
}

export global DevToolsState {
    in property <bool> visible;
    in property <bool> docked-right;
    in-out property <length> size: 320px;
    in property <image> frame;
    in property <image> popup-frame;
    in property <bool> popup-visible;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <WebCursor> cursor;

    callback pointer(WebPointer);
    callback scroll(WebScroll) -> bool;
    callback hover(bool, length, length);
    callback resized(length, length);
    callback focus-changed(bool);
    callback close();
    callback toggle-dock();
    callback size-committed(length);
}

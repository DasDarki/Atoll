import { WorkspaceItem, SidebarRow, IslandTarget, MenuItemData, ArchiveItem, ExportIslandItem, DialogData, WebCursor, WebPointer, WebScroll, SuggestionItem, Completion, PaletteItem, PageHit, BookmarkItem, HistoryItem, PageSecurity, SiteInfoDetail, DownloadItem, UploadFile, PasswordItem, PluginItem } from "structs.slint";

export global SidebarState {
    in property <bool> visible: true;
    in-out property <bool> hovering;
    in-out property <int> hover-tab;
    in-out property <string> hover-title;
    in-out property <string> hover-url;
    in-out property <string> hover-detail;
    in-out property <length> hover-y;
    in property <[WorkspaceItem]> workspaces;
    in property <[SidebarRow]> rows;
    in property <[IslandTarget]> island-targets;
    in property <[WorkspaceItem]> window-targets;
    in property <bool> archive-suggestion;

    callback select-workspace(int);
    callback create-workspace();
    callback workspace-action(int, string);
    callback move-island-to-workspace(int, int);

    callback activate-tab(int);
    /// Ein Klick auf eine Tab-Zeile, mit Strg und Umschalt wie sie gehalten wurden.
    callback tab-clicked(int, bool, bool);
    callback close-tab(int);
    callback tab-action(int, string);
    callback move-tab-to-island(int, int);
    callback move-tab-to-workspace(int, int);
    callback tab-drag-released(int, length, length);
    in property <int> tab-drag-id: -2;
    /// Die Zeile, über der die Linie steht, wo der Tab landen würde.
    in property <int> tab-drop-row: -2;
    callback tab-drag-started(int);
    callback tab-drag-over-tab(int, bool);
    callback tab-drag-over-island(int);

    callback toggle-island(int);
    callback island-action(int, string);
    in property <int> island-drag-id: -1;
    in property <int> island-drop-before: -2;
    callback island-drag-started(int);
    callback island-drag-hover(int, bool);
    callback island-drag-ended();
    callback set-island-color(int, int);
    callback create-island();

    callback open-archive();
    callback open-import();
    callback open-export();
}

export global BrowserState {
    in property <string> title;
    in property <string> address;
    in property <PageSecurity> security;
    in property <bool> private-tab;
    in property <bool> tor-tab;
    /// Whether this page has no protection at all, which the shield shows.
    in property <bool> protection-off;
    /// 0 aus, 1 wird verbunden, 2 verbunden, 3 unterbrochen.
    in property <int> vpn-state;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> loading;
    in property <float> progress;
    in property <bool> has-page;
    in property <image> page-frame;
    in property <image> popup-frame;
    in property <bool> popup-visible;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <WebCursor> cursor;
    in property <string> status-text;
    in property <string> tooltip;
    in property <bool> fullscreen;
    in property <bool> crashed;
    in property <bool> find-visible;
    in property <string> find-result;

    /// Was die Pille sagt, die zeigt, dass die Seite schon in einem anderen Tab offen ist.
    /// Leer, wenn es keinen solchen Tab gibt.
    in property <string> also-open;
    callback show-other-tab();

    callback navigate(string);
    callback show-site-info();
    callback show-shield();
    in property <bool> login-form;
    callback show-passwords();
    in property <bool> page-video;
    callback download-video();

    in property <bool> maximized;
    callback window-drag();
    callback window-control(string);
    callback window-resize(string);
    callback toggle-sidebar();

    in property <[SuggestionItem]> suggestions;
    in property <bool> suggestions-visible;
    in property <int> suggestion-index: -1;
    in property <int> suggestion-source;
    callback address-edited(int, string) -> Completion;
    callback address-submitted(int, string);
    callback suggestion-move(int) -> string;
    callback suggestion-activate(int);
    callback suggestions-dismissed();

    in property <bool> home-button-visible;
    callback go-home();

    in property <bool> downloads-button-visible;
    in property <bool> downloads-running;
    in property <float> downloads-progress;
    callback open-downloads();

    in property <bool> page-bookmarked;
    in property <bool> bookmarks-bar-visible;
    in property <[BookmarkItem]> bookmarks-bar;
    callback toggle-bookmark();
    callback open-bookmark(int, bool);
    callback open-bookmark-folder(int, length, length);
    callback bookmark-action(int, string);
    callback bookmark-dropped(int, int, int);

    callback go-back();
    callback go-forward();
    callback reload(bool);
    callback stop();
    callback menu-action(string);

    callback web-pointer(WebPointer);
    callback web-scroll(WebScroll) -> bool;
    callback web-hover(bool, length, length);
    callback web-resized(length, length);
    callback web-focus-changed(bool);

    callback find(string, bool);
    callback close-find();
}


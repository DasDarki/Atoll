export global Theme {
    out property <color> background: #0b0c14;
    out property <color> chrome: #10111b;
    out property <color> surface: #171927;
    out property <color> surface-raised: #1e2133;
    out property <color> hover: #ffffff0d;
    out property <color> pressed: #ffffff17;
    out property <color> selected: #7c6cff29;
    out property <color> border: #ffffff12;
    out property <color> border-strong: #ffffff24;
    out property <color> text: #e8eaf6;
    out property <color> text-muted: #9ba1bf;
    out property <color> text-faint: #646a88;
    out property <color> accent: #7c6cff;
    out property <color> accent-strong: #6352ff;
    out property <color> accent-cyan: #22d3ee;
    out property <brush> accent-gradient: @linear-gradient(120deg, #6a5cff 0%, #3b82f6 55%, #22d3ee 100%);
    out property <color> danger: #fb7185;
    out property <color> scrim: #05060cc0;
    out property <length> radius-small: 6px;
    out property <length> radius: 8px;
    out property <length> radius-large: 14px;
    out property <length> font-small: 11px;
    out property <length> font-normal: 13px;
    out property <length> font-large: 15px;
    out property <length> sidebar-width: 276px;
    out property <length> toolbar-height: 46px;
    out property <[color]> island-colors: [#8b5cf6, #3b82f6, #06b6d4, #14b8a6, #22c55e, #f59e0b, #f43f5e, #64748b];
}

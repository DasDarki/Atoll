import { Theme } from "../theme.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.checked ? Theme.accent-strong : touch.has-hover ? Theme.pressed : Theme.surface-raised;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.border-strong;
    animate background { duration: 120ms; }

    Rectangle {
        width: 16px;
        height: 16px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: root.checked ? #ffffff : Theme.text-muted;
        animate x { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

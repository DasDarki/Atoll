import { Theme } from "theme.slint";
import { SidebarState, BrowserState, OverlayState, SettingsState } from "state.slint";
import { DialogKind } from "structs.slint";
import { Sidebar } from "sidebar/sidebar.slint";
import { Toolbar } from "toolbar/toolbar.slint";
import { WebView } from "content/web-view.slint";
import { NewTabPage } from "content/new-tab-page.slint";
import { FindBar } from "content/find-bar.slint";
import { PopupMenu } from "overlays/popup-menu.slint";
import { PromptDialog } from "overlays/prompt-dialog.slint";
import { ImportDialog } from "overlays/import-dialog.slint";
import { ImportReport } from "overlays/import-report.slint";
import { ExportDialog } from "overlays/export-dialog.slint";
import { ArchivePanel } from "overlays/archive-panel.slint";
import { Toast } from "overlays/toast.slint";
import { SuggestionList } from "overlays/suggestion-list.slint";
import { CommandPalette } from "overlays/command-palette.slint";
import { FolderPopup } from "overlays/folder-popup.slint";
import { BookmarkEditor } from "overlays/bookmark-editor.slint";
import { BookmarkManager } from "overlays/bookmark-manager.slint";
import { HoverCard } from "overlays/hover-card.slint";
import { SettingsPage } from "overlays/settings-page.slint";
import { SiteInfoPopup } from "overlays/site-info-popup.slint";
import { DownloadsPanel } from "overlays/downloads-panel.slint";
import { BookmarksBar } from "toolbar/bookmarks-bar.slint";

export { SidebarState, BrowserState, OverlayState, SettingsState }
export { WorkspaceItem, SidebarRow, IslandTarget, MenuItemData, ArchiveItem, ExportIslandItem, DialogData, DialogKind, RowKind, TabLoadState, PointerAction, PointerButton, WebCursor, WebPointer, WebScroll, SuggestionKind, SuggestionItem, Completion, PaletteKind, PaletteItem, BookmarkItem, PageSecurity, SiteInfoDetail, DownloadItem, DownloadItemStatus } from "structs.slint";

export component AppWindow inherits Window {
    title: BrowserState.title == "" ? "Atoll" : BrowserState.title + " - Atoll";
    icon: @image-url("images/logo-64.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.background;
    default-font-size: Theme.font-normal;
    full-screen: BrowserState.fullscreen;

    out property <bool> web-focused: web.focused;
    out property <length> content-x: content.absolute-position.x;
    out property <length> content-y: content.absolute-position.y;
    out property <bool> modal-open: OverlayState.dialog.kind != DialogKind.none
        || OverlayState.palette-visible
        || OverlayState.folder-popup-visible
        || OverlayState.site-info-visible
        || OverlayState.downloads-visible
        || OverlayState.bookmark-editor-visible
        || OverlayState.bookmark-manager-visible
        || SettingsState.visible
        || OverlayState.import-visible
        || OverlayState.export-visible
        || OverlayState.archive-visible
        || OverlayState.report-visible
        || OverlayState.menu-visible;

    public function focus-address() {
        toolbar.focus-address();
    }

    public function focus-web() {
        web.focus-page();
    }

    public function focus-new-tab() {
        new-tab.focus-input();
    }

    public function focus-find() {
        find-bar.focus-input();
    }

    property <bool> hover-card-shown;
    property <bool> hovering: SidebarState.hovering;
    changed hovering => {
        if (!self.hovering) {
            self.hover-card-shown = false;
        }
    }

    Timer {
        interval: 550ms;
        running: SidebarState.hovering && !root.hover-card-shown;
        triggered => { root.hover-card-shown = true; }
    }

    HorizontalLayout {
        if !BrowserState.fullscreen && SidebarState.visible : Sidebar { }

        VerticalLayout {
            toolbar := Toolbar {
                visible: !BrowserState.fullscreen;
                height: BrowserState.fullscreen ? 0px : Theme.toolbar-height;
            }

            if BrowserState.bookmarks-bar-visible && !BrowserState.fullscreen : BookmarksBar { }

            content := Rectangle {
                web := WebView {
                    visible: BrowserState.has-page;
                }

                new-tab := NewTabPage {
                    visible: !BrowserState.has-page;
                }

                find-bar := FindBar {
                    x: parent.width - self.width - 16px;
                    y: 12px;
                    visible: BrowserState.find-visible && BrowserState.has-page;
                }
            }
        }
    }

    if root.hover-card-shown && SidebarState.hovering && SidebarState.visible && !root.modal-open : HoverCard {
        x: Theme.sidebar-width + 8px;
        y: clamp(SidebarState.hover-y - 4px, 8px, max(8px, root.height - self.height - 8px));
    }

    if BrowserState.suggestions-visible && BrowserState.suggestions.length > 0 : SuggestionList {
        x: BrowserState.suggestion-source == 0 ? toolbar.address-x : new-tab.anchor-x;
        y: BrowserState.suggestion-source == 0 ? toolbar.address-y : new-tab.anchor-y;
        width: BrowserState.suggestion-source == 0 ? toolbar.address-width : new-tab.anchor-width;
    }

    if OverlayState.folder-popup-visible : FolderPopup {
        width: root.width;
        height: root.height;
    }

    if OverlayState.site-info-visible : SiteInfoPopup {
        width: root.width;
        height: root.height;
        anchor-x: toolbar.address-x;
        anchor-y: toolbar.address-y;
    }

    if OverlayState.downloads-visible : DownloadsPanel {
        width: root.width;
        height: root.height;
    }

    if OverlayState.palette-visible : CommandPalette {
        width: root.width;
        height: root.height;
    }

    if OverlayState.bookmark-manager-visible : BookmarkManager {
        width: root.width;
        height: root.height;
    }

    if OverlayState.bookmark-editor-visible : BookmarkEditor {
        width: root.width;
        height: root.height;
    }

    if SettingsState.visible : SettingsPage {
        width: root.width;
        height: root.height;
    }

    if OverlayState.menu-visible : PopupMenu {
        width: root.width;
        height: root.height;
    }

    if OverlayState.archive-visible : ArchivePanel {
        width: root.width;
        height: root.height;
    }

    if OverlayState.import-visible : ImportDialog {
        width: root.width;
        height: root.height;
    }

    if OverlayState.export-visible : ExportDialog {
        width: root.width;
        height: root.height;
    }

    if OverlayState.report-visible : ImportReport {
        width: root.width;
        height: root.height;
    }

    if OverlayState.dialog.kind != DialogKind.none : PromptDialog {
        width: root.width;
        height: root.height;
    }

    if OverlayState.toast-visible : Toast {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 28px;
    }
}

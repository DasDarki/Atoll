import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { OverlayState } from "../state.slint";
import { Modal } from "modal.slint";
import { ActionButton, ButtonKind } from "../widgets/button.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { FieldLabel } from "../widgets/field-label.slint";

export component ArchivePanel inherits Modal {
    title: @tr("Archiv");
    card-width: 620px;
    dismissed => { OverlayState.archive-close(); }

    Text {
        text: @tr("Archivierte Inseln verschwinden aus der Sidebar, bleiben aber vollständig erhalten.");
        color: Theme.text-muted;
        font-size: Theme.font-normal;
        wrap: word-wrap;
    }

    if OverlayState.archive-suggestions.length > 0 : VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                FieldLabel { text: @tr("VORSCHLÄGE"); }
                Text {
                    text: OverlayState.archive-suggestion-weeks == 1
                        ? @tr("Seit über einer Woche nicht benutzt.")
                        : @tr("Seit über {} Wochen nicht benutzt.", OverlayState.archive-suggestion-weeks);
                    color: Theme.text-faint;
                    font-size: Theme.font-small + 1px;
                }
            }
            ActionButton {
                y: (parent.height - self.height) / 2;
                text: @tr("Alle archivieren");
                clicked => { OverlayState.archive-all-suggested(); }
            }
        }

        Rectangle {
            height: min(220px, OverlayState.archive-suggestions.length * 56px + 8px);
            border-radius: Theme.radius;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.border;
            ListView {
                for item in OverlayState.archive-suggestions : Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 10px;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: item.color;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: item.name;
                                color: Theme.text;
                                font-size: Theme.font-normal;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: @tr("{} · {} · zuletzt benutzt {}", item.workspace, @tr("{n} Tab" | "{n} Tabs" % item.tab-count), item.archived);
                                color: Theme.text-faint;
                                font-size: Theme.font-small + 1px;
                                overflow: elide;
                            }
                        }
                        ActionButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Behalten");
                            clicked => { OverlayState.archive-keep(item.id); }
                        }
                        ActionButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Archivieren");
                            kind: ButtonKind.primary;
                            clicked => { OverlayState.archive-suggested(item.id); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }
        }

        FieldLabel { text: @tr("ARCHIVIERT"); }
    }

    if OverlayState.archive-items.length == 0 : Rectangle {
        height: 120px;
        border-radius: Theme.radius;
        background: Theme.background;
        Text {
            text: @tr("Das Archiv ist leer.");
            color: Theme.text-faint;
            font-size: Theme.font-normal;
        }
    }

    if OverlayState.archive-items.length > 0 : Rectangle {
        height: min(360px, OverlayState.archive-items.length * 56px + 8px);
        border-radius: Theme.radius;
        background: Theme.background;
        border-width: 1px;
        border-color: Theme.border;
        ListView {
            for item in OverlayState.archive-items : Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 10px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: item.color;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: item.name;
                            color: Theme.text;
                            font-size: Theme.font-normal;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: @tr("{} · {} · archiviert {}", item.workspace, @tr("{n} Tab" | "{n} Tabs" % item.tab-count), item.archived);
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            overflow: elide;
                        }
                    }
                    ActionButton {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Wiederherstellen");
                        clicked => { OverlayState.archive-restore(item.id); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../icons/trash.svg");
                        tint: Theme.danger;
                        clicked => { OverlayState.archive-delete(item.id); }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        ActionButton {
            text: @tr("Schließen");
            kind: ButtonKind.primary;
            clicked => { OverlayState.archive-close(); }
        }
    }
}

import { Theme } from "../theme.slint";
import { OverlayState } from "../state.slint";
import { TextField } from "../widgets/text-field.slint";

component LoginRow inherits Rectangle {
    in property <string> title;
    in property <string> username;
    in property <string> detail;
    in property <bool> matches;
    callback clicked();

    height: 52px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        Rectangle {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: root.matches ? Theme.accent.with-alpha(0.14) : Theme.surface;
            Image {
                width: 14px;
                height: 14px;
                source: @image-url("../icons/key.svg");
                colorize: root.matches ? Theme.accent : Theme.text-faint;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-normal;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.username == "" ? root.detail : root.detail == "" ? root.username : root.username + " · " + root.detail;
                color: Theme.text-faint;
                font-size: Theme.font-small + 1px;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PasswordPopup inherits Rectangle {
    in property <length> anchor-x;
    in property <length> anchor-y;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                OverlayState.passwords-close();
            }
        }
    }

    card := Rectangle {
        x: max(8px, min(root.anchor-x - self.width, root.width - self.width - 8px));
        y: root.anchor-y;
        width: 380px;
        height: layout.preferred-height;
        border-radius: Theme.radius;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000a8;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Image {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../icons/key.svg");
                    colorize: Theme.accent;
                }
                Text {
                    text: "1Password";
                    color: Theme.text;
                    font-size: Theme.font-large;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: OverlayState.passwords-host;
                    color: Theme.text-faint;
                    font-size: Theme.font-normal;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if OverlayState.passwords-status != "" : Text {
                text: OverlayState.passwords-status;
                color: OverlayState.passwords-busy ? Theme.text-muted : Theme.text;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }

            if OverlayState.passwords-items.length > 0 : Rectangle {
                height: min(280px, OverlayState.passwords-items.length * 54px);
                Flickable {
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        spacing: 2px;
                        for item[index] in OverlayState.passwords-items : LoginRow {
                            title: item.title;
                            username: item.username;
                            detail: item.detail;
                            matches: item.matches;
                            clicked => { OverlayState.passwords-choose(index); }
                        }
                    }
                }
            }

            if !OverlayState.passwords-busy : TextField {
                text <=> OverlayState.passwords-query;
                placeholder: "Alle Logins durchsuchen";
                edited => { OverlayState.passwords-query-edited(self.text); }
                escape => { OverlayState.passwords-close(); }
                accepted => {
                    if (OverlayState.passwords-items.length > 0) {
                        OverlayState.passwords-choose(0);
                    }
                }
            }
        }
    }

    FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                OverlayState.passwords-close();
                return accept;
            }
            if (event.text == Key.Return && OverlayState.passwords-items.length > 0) {
                OverlayState.passwords-choose(0);
                return accept;
            }
            return reject;
        }
    }
}

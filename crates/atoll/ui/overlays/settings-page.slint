import { ComboBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserState, SettingsState } from "../state.slint";
import { Modal } from "modal.slint";
import { ActionButton, ButtonKind } from "../widgets/button.slint";
import { TextField } from "../widgets/text-field.slint";
import { FieldLabel } from "../widgets/field-label.slint";
import { Toggle } from "../widgets/toggle.slint";
import { Segmented } from "../widgets/segmented.slint";
import { PluginItem } from "../structs.slint";

component SectionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.text : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: Theme.font-normal;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.text-faint;
                font-size: Theme.font-small + 1px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 6px;
    padding-bottom: 4px;
    FieldLabel { text: root.text; }
}

export component SettingsPage inherits Modal {
    title: @tr("Einstellungen");
    card-width: 780px;
    dismissed => { SettingsState.close(); }

    HorizontalLayout {
        height: min(500px, root.height - 180px);
        spacing: 18px;

        VerticalLayout {
            width: 178px;
            spacing: 2px;
            alignment: start;

            SectionButton {
                text: @tr("Allgemein");
                icon: @image-url("../icons/settings.svg");
                selected: SettingsState.section == 0;
                clicked => { SettingsState.section = 0; }
            }
            SectionButton {
                text: @tr("Darstellung");
                icon: @image-url("../icons/layout.svg");
                selected: SettingsState.section == 1;
                clicked => { SettingsState.section = 1; }
            }
            SectionButton {
                text: @tr("Tabs");
                icon: @image-url("../icons/tab.svg");
                selected: SettingsState.section == 2;
                clicked => { SettingsState.section = 2; }
            }
            SectionButton {
                text: @tr("Downloads");
                icon: @image-url("../icons/download.svg");
                selected: SettingsState.section == 3;
                clicked => { SettingsState.section = 3; }
            }
            SectionButton {
                text: @tr("Datenschutz");
                icon: @image-url("../icons/shield.svg");
                selected: SettingsState.section == 4;
                clicked => { SettingsState.section = 4; }
            }
            SectionButton {
                text: @tr("Erweiterungen");
                icon: @image-url("../icons/layers.svg");
                selected: SettingsState.section == 5;
                clicked => { SettingsState.section = 5; }
            }
            SectionButton {
                text: @tr("Konto & Sync");
                icon: @image-url("../icons/key.svg");
                selected: SettingsState.section == 6;
                clicked => { SettingsState.section = 6; }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        ScrollView {
            horizontal-stretch: 1;
            content-width: self.visible-width;

            VerticalLayout {
                padding-right: 14px;
                alignment: start;

                if SettingsState.section == 0 : VerticalLayout {
                    SectionTitle { text: @tr("STARTSEITE"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> SettingsState.start-page;
                                placeholder: @tr("Leer lassen für die Atoll-Startseite");
                                edited => { SettingsState.changed("start-page"); }
                                accepted => { SettingsState.changed("start-page"); }
                            }
                            ActionButton {
                                text: @tr("Aktuelle Seite");
                                enabled: BrowserState.has-page;
                                clicked => { SettingsState.use-current-page(); }
                            }
                        }
                        Text {
                            text: @tr("Wird vom Startseiten-Button und mit Alt+Pos1 geöffnet.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Neue Tabs mit der Startseite öffnen");
                        description: SettingsState.start-page == "" ? @tr("Dafür zuerst eine Startseite eintragen.") : @tr("Sonst zeigen neue Tabs die Atoll-Startseite mit der Suche.");
                        Toggle {
                            enabled: SettingsState.start-page != "";
                            checked <=> SettingsState.new-tab-start-page;
                            toggled => { SettingsState.changed("new-tab-start-page"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Startseiten-Button in der Symbolleiste");
                        Toggle {
                            checked <=> SettingsState.home-button;
                            toggled => { SettingsState.changed("home-button"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Verbergen");
                        description: @tr("Diese Tasten legen Schwarz über alle Fenster und schalten jeden Ton ab, dieselben Tasten holen alles zurück. Darunter läuft alles weiter. Mit Strg oder Alt, zum Beispiel Alt+L. Gerade aktiv: {}", SettingsState.hide-shortcut-active);
                        TextField {
                            width: 140px;
                            text <=> SettingsState.hide-shortcut;
                            placeholder: "Alt+L";
                            edited => { SettingsState.changed("hide-shortcut"); }
                            accepted => { SettingsState.changed("hide-shortcut"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("SUCHMASCHINE"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        ComboBox {
                            model: SettingsState.search-engines;
                            current-index <=> SettingsState.search-engine;
                            selected => { SettingsState.changed("search-engine"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : TextField {
                            text <=> SettingsState.search-url;
                            placeholder: "https://example.org/search?q={query}";
                            edited => { SettingsState.changed("search-url"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : Text {
                            text: SettingsState.search-url-valid ? @tr("{{query}} wird durch den Suchbegriff ersetzt.") : @tr("Die Adresse muss {{query}} enthalten, bis dahin bleibt die bisherige Suche aktiv.");
                            color: SettingsState.search-url-valid ? Theme.text-faint : Theme.danger;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    SectionTitle { text: @tr("SPRACHE"); }
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        ComboBox {
                            model: SettingsState.languages;
                            current-index <=> SettingsState.language;
                            selected => { SettingsState.changed("language"); }
                        }
                        Text {
                            text: @tr("Gilt sofort, ohne Neustart.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("ÜBER ATOLL"); }
                    SettingRow {
                        title: @tr("Version {}", SettingsState.version);
                        description: SettingsState.update-status;
                        ActionButton {
                            text: @tr("Jetzt sehen");
                            clicked => { SettingsState.check-for-updates(); }
                        }
                    }
                    SettingRow {
                        title: @tr("Nach neuen Versionen sehen");
                        description: @tr("Einmal am Tag fragt Atoll bei GitHub nach der neuesten Version. Heruntergeladen wird nichts, und die Frage nimmt denselben Weg wie alles andere, also auch durch dein VPN.");
                        Toggle {
                            checked <=> SettingsState.update-check;
                            toggled => { SettingsState.changed("update-check"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Release-Seite");
                        description: @tr("Alle Versionen mit ihren Anmerkungen, auf GitHub.");
                        ActionButton {
                            text: @tr("Öffnen");
                            clicked => { SettingsState.open-release-page(); }
                        }
                    }
                }

                if SettingsState.section == 1 : VerticalLayout {
                    SettingRow {
                        title: @tr("Sidebar anzeigen");
                        description: @tr("Strg+B blendet sie jederzeit ein oder aus.");
                        Toggle {
                            checked <=> SettingsState.sidebar-visible;
                            toggled => { SettingsState.changed("sidebar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lesezeichenleiste anzeigen");
                        description: @tr("Strg+Umschalt+B blendet sie jederzeit ein oder aus.");
                        Toggle {
                            checked <=> SettingsState.bookmarks-bar-visible;
                            toggled => { SettingsState.changed("bookmarks-bar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lesezeichenleiste nur mit Lesezeichen anzeigen");
                        description: @tr("Blendet die Leiste aus, solange sie leer ist.");
                        Toggle {
                            enabled: SettingsState.bookmarks-bar-visible;
                            checked <=> SettingsState.bookmarks-bar-auto-hide;
                            toggled => { SettingsState.changed("bookmarks-bar-auto-hide"); }
                        }
                    }
                }

                if SettingsState.section == 2 : VerticalLayout {
                    SettingRow {
                        title: @tr("Eingefrorene Tabs im Hintergrund");
                        description: @tr("So viele zuletzt genutzte Tabs bleiben geladen und erscheinen sofort. Alle anderen schlafen und kosten keinen Arbeitsspeicher.");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-frozen-limit;
                            value <=> SettingsState.frozen-limit;
                            edited => { SettingsState.changed("frozen-limit"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Arbeitsspeicher begrenzen");
                        description: @tr("Belegen die Seiten mehr als das Budget, schlafen die am längsten nicht genutzten Hintergrund-Tabs ein. Tabs mit Wiedergabe, ungesendeten Eingaben und angepinnte Tabs bleiben geladen. ") + SettingsState.memory-usage;
                        Toggle {
                            checked <=> SettingsState.memory-limit-enabled;
                            toggled => { SettingsState.changed("memory-limit"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Budget in GB");
                        SpinBox {
                            width: 110px;
                            enabled: SettingsState.memory-limit-enabled;
                            minimum: 1;
                            maximum: SettingsState.max-memory-limit-gb;
                            value <=> SettingsState.memory-limit-gb;
                            edited => { SettingsState.changed("memory-limit"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Archivierung vorschlagen nach Wochen");
                        description: @tr("Inseln, die so lange nicht benutzt wurden, werden in der Sidebar markiert und im Archiv vorgeschlagen. Archiviert wird nur nach deiner Bestätigung. 0 schaltet die Vorschläge aus.");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-archive-suggestion-weeks;
                            value <=> SettingsState.archive-suggestion-weeks;
                            edited => { SettingsState.changed("archive-suggestion-weeks"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Tabs archivieren nach Tagen");
                        description: @tr("Tabs, die so lange nicht besucht wurden, kommen von selbst ins Archiv, mit ihrer Insel und ihrem Workspace. Angepinnte, private und gerade geladene Tabs bleiben. Aus dem Archiv kommt ein Tab in seine Insel zurück, gibt es sie nicht mehr, in eine gleiche. 0 schaltet das aus.");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-archive-tabs-after-days;
                            value <=> SettingsState.archive-tabs-after-days;
                            edited => { SettingsState.changed("archive-tabs-after-days"); }
                        }
                    }
                }

                if SettingsState.section == 3 : VerticalLayout {
                    SectionTitle { text: @tr("SPEICHERORT"); }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: Theme.radius;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: SettingsState.download-directory;
                                color: Theme.text;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if SettingsState.download-directory-custom : ActionButton {
                            text: @tr("Standard");
                            clicked => { SettingsState.reset-download-directory(); }
                        }
                        ActionButton {
                            text: @tr("Ändern…");
                            clicked => { SettingsState.choose-download-directory(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Vor jedem Download nach dem Speicherort fragen");
                        description: @tr("Zeigt einen Speichern-Dialog, statt direkt im Download-Ordner zu speichern.");
                        Toggle {
                            checked <=> SettingsState.download-ask;
                            toggled => { SettingsState.changed("download-ask"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Download-Übersicht beim Start eines Downloads öffnen");
                        description: @tr("Sonst erscheint nur eine kurze Meldung. Die Übersicht öffnet Strg+J.");
                        Toggle {
                            checked <=> SettingsState.download-panel;
                            toggled => { SettingsState.changed("download-panel"); }
                        }
                    }
                }

                if SettingsState.section == 4 : VerticalLayout {
                    SectionTitle { text: @tr("VPN"); }
                    SettingRow {
                        title: @tr("Alles durch das VPN schicken");
                        description: SettingsState.vpn-status;
                        Toggle {
                            checked <=> SettingsState.vpn-enabled;
                            toggled => { SettingsState.changed("vpn-enabled"); }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 8px;
                        Text {
                            text: @tr("Atoll bringt kein VPN mit. Trag den Proxy deines Dienstes ein; solange er nicht erreichbar ist, lädt Atoll gar nichts, damit nichts daran vorbeigeht.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        Segmented {
                            options: ["SOCKS5", "HTTP", "HTTPS", "WireGuard"];
                            selected <=> SettingsState.vpn-kind;
                            changed-by-user => { SettingsState.changed("vpn-kind"); }
                        }
                        if SettingsState.vpn-kind != 3 : HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> SettingsState.vpn-host;
                                placeholder: @tr("Adresse des Proxys, z.B. proxy.anbieter.net");
                                edited => { SettingsState.changed("vpn-host"); }
                                accepted => { SettingsState.changed("vpn-host"); }
                            }
                            SpinBox {
                                width: 110px;
                                minimum: 1;
                                maximum: 65535;
                                value <=> SettingsState.vpn-port;
                                edited => { SettingsState.changed("vpn-port"); }
                            }
                        }
                        if SettingsState.vpn-kind != 3 : HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> SettingsState.vpn-user;
                                placeholder: @tr("Benutzername, falls nötig");
                                edited => { SettingsState.changed("vpn-user"); }
                                accepted => { SettingsState.changed("vpn-user"); }
                            }
                            TextField {
                                horizontal-stretch: 1;
                                secret: true;
                                text <=> SettingsState.vpn-password;
                                placeholder: @tr("Passwort, falls nötig");
                                edited => { SettingsState.changed("vpn-password"); }
                                accepted => { SettingsState.changed("vpn-password"); }
                            }
                        }
                        if SettingsState.vpn-kind != 3 : Text {
                            text: @tr("Benutzername und Passwort liegen im Profil, wie bei jeder anderen Proxy-Einstellung eines Browsers.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        if SettingsState.vpn-kind == 3 : HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: SettingsState.vpn-config != "" ? SettingsState.vpn-config : @tr("Noch keine Konfiguration gewählt");
                                    color: SettingsState.vpn-config != "" ? Theme.text : Theme.text-faint;
                                    font-size: Theme.font-normal;
                                    overflow: elide;
                                }
                            }
                            ActionButton {
                                text: @tr("Konfiguration wählen…");
                                clicked => { SettingsState.choose-vpn-config(); }
                            }
                        }
                        if SettingsState.vpn-kind == 3 : Text {
                            text: @tr("Die .conf-Datei, die dein Dienst für WireGuard ausgibt. Atoll baut den Tunnel selbst im Browser auf, ohne root und ohne am System etwas zu ändern. Namen werden im Tunnel nachgeschlagen, dafür braucht die Datei eine DNS-Zeile.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                    if SettingsState.vpn-exceptions != "" : SettingRow {
                        title: @tr("Am VPN vorbei");
                        description: SettingsState.vpn-exceptions;
                        ActionButton {
                            text: @tr("Alle entfernen");
                            clicked => { SettingsState.clear-vpn-exceptions(); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("SEITENSUCHE"); }
                    SettingRow {
                        title: @tr("Merken, was die offenen Seiten zeigen");
                        description: @tr("Strg+Umschalt+F sucht dann auch im Text der Seiten, nicht nur in Adresse und Titel. Gemerkt wird nur für offene Tabs, nie für private.");
                        Toggle {
                            checked <=> SettingsState.page-text-enabled;
                            toggled => { SettingsState.changed("page-text-enabled"); }
                        }
                    }
                    if SettingsState.page-text-enabled : SettingRow {
                        title: @tr("Auch, was du in Felder tippst");
                        description: SettingsState.page-text-fields ? @tr("So findest du den Tab wieder, in dessen Suchfeld du etwas eingetippt hast. Passwortfelder bleiben immer außen vor.") : @tr("Eingetipptes bleibt außen vor. Dann findest du eine Seite nur an dem, was auf ihr steht.");
                        Toggle {
                            checked <=> SettingsState.page-text-fields;
                            toggled => { SettingsState.changed("page-text-fields"); }
                        }
                    }
                    if SettingsState.page-text-enabled : SettingRow {
                        title: @tr("Auch Entwürfe in Editoren auf Seiten");
                        description: SettingsState.page-text-drafts ? @tr("Ein halb geschriebener Brief in einem Webmailer gehört dann zum Text der Seite.") : @tr("Was du selbst in einen Editor schreibst, bleibt außen vor.");
                        Toggle {
                            checked <=> SettingsState.page-text-drafts;
                            toggled => { SettingsState.changed("page-text-drafts"); }
                        }
                    }
                    if SettingsState.page-text-enabled : SettingRow {
                        title: @tr("Gemerkte Seiteninhalte");
                        description: SettingsState.page-text-size;
                        ActionButton {
                            text: @tr("Löschen");
                            clicked => { SettingsState.forget-page-texts(); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("TORRENTS"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 8px;
                        Segmented {
                            options: [@tr("Durch Atolls VPN"), @tr("Über ein System-VPN")];
                            selected <=> SettingsState.torrent-route;
                            changed-by-user => { SettingsState.changed("torrent-route"); }
                        }
                        Text {
                            text: SettingsState.torrent-status;
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        if SettingsState.torrent-route == 1 : ComboBox {
                            model: SettingsState.torrent-devices;
                            current-index <=> SettingsState.torrent-device;
                            selected => { SettingsState.torrent-device-chosen(self.current-index); }
                        }
                        if SettingsState.torrent-route == 1 : Text {
                            text: @tr("Atoll bindet jeden Socket eines Torrents an dieses Gerät. Fällt es weg, geht nichts mehr durch - und BitTorrent kann alles, was es braucht.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        padding-bottom: 8px;
                        Text {
                            text: @tr("Wenn du eine .torrent-Datei herunterlädst");
                            color: Theme.text;
                            font-size: Theme.font-normal;
                        }
                        Segmented {
                            options: [@tr("Fragen"), @tr("Sofort laden"), @tr("Nur die Datei")];
                            selected <=> SettingsState.torrent-files;
                            changed-by-user => { SettingsState.changed("torrent-files"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Beim Laden auch hochladen");
                        description: SettingsState.torrent-upload ? @tr("So gehört es sich im Schwarm: Atoll gibt Stücke ab, solange ein Torrent lädt, und hört danach auf.") : @tr("Achtung: Ohne Hochladen wirst du von vielen Schwärmen abgestraft oder ausgeschlossen, und du nimmst mehr, als du gibst.");
                        Toggle {
                            checked <=> SettingsState.torrent-upload;
                            toggled => { SettingsState.changed("torrent-upload"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("WERBEBLOCKER"); }
                    SettingRow {
                        title: @tr("Werbung und Tracker blockieren");
                        description: SettingsState.adblock-status;
                        Toggle {
                            checked <=> SettingsState.adblock-enabled;
                            toggled => { SettingsState.changed("adblock-enabled"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Filterlisten aktualisieren");
                        description: @tr("Geschieht automatisch alle vier Tage.");
                        ActionButton {
                            text: @tr("Jetzt aktualisieren");
                            enabled: !SettingsState.adblock-updating;
                            clicked => { SettingsState.update-filter-lists(); }
                        }
                    }
                    if SettingsState.adblock-exceptions != "" : Divider { }
                    if SettingsState.adblock-exceptions != "" : SettingRow {
                        title: @tr("Eigene Einstellungen für");
                        description: SettingsState.adblock-exceptions;
                        ActionButton {
                            text: @tr("Alle entfernen");
                            clicked => { SettingsState.clear-adblock-exceptions(); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("COOKIE-BANNER"); }
                    SettingRow {
                        title: @tr("Banner verstecken");
                        description: SettingsState.cookie-banners-status;
                        Toggle {
                            checked <=> SettingsState.cookie-banners-hide;
                            toggled => { SettingsState.changed("cookie-banners-hide"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Banner ablehnen");
                        description: @tr("Atoll drückt bei den bekannten Einwilligungsdiensten den Knopf, der alles ablehnt. So weiß die Seite, dass du nein gesagt hast, statt nur nicht zu fragen.");
                        Toggle {
                            checked <=> SettingsState.cookie-banners-answer;
                            toggled => { SettingsState.changed("cookie-banners-answer"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: "1PASSWORD"; }
                    SettingRow {
                        title: @tr("Anmeldungen mit 1Password ausfüllen");
                        description: SettingsState.onepassword-status;
                    }
                    SettingRow {
                        title: @tr("Von selbst ausfüllen");
                        description: SettingsState.password-autofill ? @tr("Hat eine Seite genau eine gespeicherte Anmeldung, füllt Atoll sie beim Öffnen aus. Dafür fragt 1Password auf jeder Anmeldeseite nach Erlaubnis, das kann lästig werden. Was du selbst getippt hast, bleibt stehen.") : @tr("Ausgefüllt wird nur auf Knopfdruck, über den Schlüssel in der Adressleiste oder Strg+Umschalt+L. Dann fragt 1Password auch nur dann.");
                        Toggle {
                            checked <=> SettingsState.password-autofill;
                            toggled => { SettingsState.changed("password-autofill"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Passkeys");
                        description: @tr("Atoll weist Passkeys ab. 1Password gibt seine Passkeys nur an die eigene Browser-Erweiterung heraus, weder die CLI noch die SDKs können sie lesen, und Chromiums eigenes Passkey-Fenster lässt sich hier nicht zeigen.");
                    }
                    Divider { }
                    SectionTitle { text: @tr("SEITEN, DIE ES NICHT MEHR GIBT"); }
                    VerticalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        Segmented {
                            options: [@tr("Aus"), @tr("Fragen"), @tr("Automatisch")];
                            selected <=> SettingsState.archive-fallback;
                            changed-by-user => { SettingsState.changed("archive-fallback"); }
                        }
                        Text {
                            text: @tr("Ist eine Seite nicht erreichbar, fragt Atoll das Internet Archive nach einer Kopie. Dabei wandert die Adresse der Seite dorthin. In privaten Tabs passiert das nie.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    if SettingsState.archive-fallback != 0 : SettingRow {
                        title: @tr("Auch wenn die Seite „nicht gefunden“ meldet");
                        description: @tr("Sonst nur, wenn die Seite gar nicht antwortet.");
                        Toggle {
                            checked <=> SettingsState.archive-on-missing;
                            toggled => { SettingsState.changed("archive-on-missing"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("DATEN"); }
                    SettingRow {
                        title: @tr("Verlauf löschen");
                        description: @tr("Entfernt alle besuchten Seiten. Tabs, Inseln und Lesezeichen bleiben erhalten.");
                        ActionButton {
                            text: @tr("Löschen");
                            clicked => { SettingsState.clear-history(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Cookies löschen");
                        description: @tr("Meldet dich auf allen Websites ab.");
                        ActionButton {
                            text: @tr("Löschen");
                            clicked => { SettingsState.clear-cookies(); }
                        }
                    }
                }

                if SettingsState.section == 5 : VerticalLayout {
                    SectionTitle { text: @tr("ERWEITERUNGEN"); }
                    if SettingsState.plugins.length == 0 : SettingRow {
                        title: @tr("Keine Erweiterungen installiert");
                        description: @tr("Installiere eine aus einem Archiv oder aus Git, oder lege einen Ordner mit einer plugin.toml an.");
                    }
                    for plugin[index] in SettingsState.plugins : VerticalLayout {
                        if index > 0 : Divider { }
                        SettingRow {
                            title: plugin.name + " " + plugin.version;
                            description: plugin.detail;
                            Toggle {
                                checked: plugin.enabled;
                                toggled => { SettingsState.plugin-action(plugin.id, self.checked ? "enable" : "disable"); }
                            }
                        }
                        if plugin.permissions != "" : Text {
                            text: plugin.permissions;
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        if plugin.status != "" : Text {
                            text: plugin.status;
                            color: plugin.failed ? Theme.danger : Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        if plugin.source != "" : Text {
                            text: plugin.source;
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            alignment: start;
                            ActionButton {
                                text: @tr("Neu laden");
                                clicked => { SettingsState.plugin-action(plugin.id, "reload"); }
                            }
                            if plugin.from-git : ActionButton {
                                text: @tr("Aktualisieren");
                                clicked => { SettingsState.plugin-action(plugin.id, "update"); }
                            }
                            ActionButton {
                                text: @tr("Protokoll");
                                clicked => { SettingsState.plugin-action(plugin.id, "log"); }
                            }
                            ActionButton {
                                text: @tr("Entfernen");
                                clicked => { SettingsState.plugin-action(plugin.id, "remove"); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Erweiterung installieren");
                        description: @tr("Aus einem Zip-Archiv oder aus einem Git-Repository. Atoll fragt danach, was die Erweiterung darf.");
                        ActionButton {
                            text: @tr("Aus Archiv");
                            clicked => { SettingsState.install-plugin("archive"); }
                        }
                        ActionButton {
                            text: @tr("Aus Git");
                            clicked => { SettingsState.install-plugin("git"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Ordner der Erweiterungen");
                        description: SettingsState.plugin-directory;
                        ActionButton {
                            text: @tr("Öffnen");
                            clicked => { SettingsState.open-plugin-folder(); }
                        }
                    }
                }

                if SettingsState.section == 6 : VerticalLayout {
                    SectionTitle { text: @tr("KONTO"); }
                    SettingRow {
                        title: SettingsState.account-title;
                        description: SettingsState.account-detail;
                        if SettingsState.account-phase == 0 : ActionButton {
                            text: @tr("Mit Onyx anmelden");
                            kind: ButtonKind.primary;
                            clicked => { SettingsState.account-action("sign-in"); }
                        }
                        if SettingsState.account-phase == 1 : ActionButton {
                            text: @tr("Abbrechen");
                            clicked => { SettingsState.account-action("cancel"); }
                        }
                        if SettingsState.account-phase == 2 : ActionButton {
                            text: @tr("Abmelden");
                            clicked => { SettingsState.account-action("sign-out"); }
                        }
                    }
                    if SettingsState.account-error != "" : Text {
                        text: SettingsState.account-error;
                        color: Theme.danger;
                        font-size: Theme.font-small + 1px;
                        wrap: word-wrap;
                    }
                    if SettingsState.account-phase == 2 && SettingsState.sync-key-phase != 0 : VerticalLayout {
                        Divider { }
                        SectionTitle { text: @tr("SYNC"); }
                        if SettingsState.sync-key-phase == 1 : SettingRow {
                            title: @tr("Sync wird geprüft");
                            description: @tr("Atoll fragt den Server, ob Sync für dein Konto eingerichtet ist.");
                        }
                        if SettingsState.sync-key-phase == 2 : SettingRow {
                            title: @tr("Sync-Server nicht erreichbar");
                            description: SettingsState.sync-key-detail;
                            ActionButton {
                                text: @tr("Erneut versuchen");
                                clicked => { SettingsState.sync-action("retry"); }
                            }
                        }
                        if SettingsState.sync-key-phase == 3 || SettingsState.sync-key-phase == 4 : VerticalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 8px;
                            Text {
                                text: SettingsState.sync-key-phase == 3
                                    ? @tr("Lege eine Passphrase fest. Mit ihr wird alles verschlüsselt, bevor es dieses Gerät verlässt; der Server kann es nicht lesen. Du brauchst sie auf jedem weiteren Gerät. Vergessen lässt sie sich nur mit dem Wiederherstellungsschlüssel ausgleichen.")
                                    : @tr("Sync ist für dein Konto schon eingerichtet. Gib die Passphrase oder den Wiederherstellungsschlüssel ein, um dieses Gerät dazuzunehmen.");
                                color: Theme.text-muted;
                                font-size: Theme.font-normal;
                                wrap: word-wrap;
                            }
                            TextField {
                                text <=> SettingsState.sync-passphrase;
                                secret: true;
                                placeholder: SettingsState.sync-key-phase == 3 ? @tr("Passphrase") : @tr("Passphrase oder Wiederherstellungsschlüssel");
                                accepted => { SettingsState.sync-action(SettingsState.sync-key-phase == 3 ? "set-up" : "unlock"); }
                            }
                            if SettingsState.sync-key-phase == 3 : TextField {
                                text <=> SettingsState.sync-passphrase-repeat;
                                secret: true;
                                placeholder: @tr("Passphrase wiederholen");
                                accepted => { SettingsState.sync-action("set-up"); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                ActionButton {
                                    text: SettingsState.sync-key-phase == 3 ? @tr("Einrichten") : @tr("Entsperren");
                                    kind: ButtonKind.primary;
                                    clicked => { SettingsState.sync-action(SettingsState.sync-key-phase == 3 ? "set-up" : "unlock"); }
                                }
                                if SettingsState.sync-key-phase == 4 : ActionButton {
                                    text: @tr("Sync zurücksetzen");
                                    kind: ButtonKind.danger;
                                    clicked => { SettingsState.sync-action("reset"); }
                                }
                            }
                        }
                        if SettingsState.sync-key-phase == 5 : SettingRow {
                            title: @tr("Einen Moment …");
                            description: @tr("Aus der Passphrase wird der Schlüssel gewonnen. Das dauert absichtlich etwas.");
                        }
                        if SettingsState.sync-key-phase == 6 : VerticalLayout {
                            if SettingsState.sync-recovery-key != "" : Rectangle {
                                background: Theme.hover;
                                border-radius: Theme.radius-small;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: @tr("Dein Wiederherstellungsschlüssel. Schreib ihn auf und bewahre ihn sicher auf: Mit ihm kommst du an deine Daten, wenn du die Passphrase vergisst. Niemand sonst kann sie wiederherstellen.");
                                        color: Theme.text-muted;
                                        font-size: Theme.font-normal;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: SettingsState.sync-recovery-key;
                                        color: Theme.text;
                                        font-size: Theme.font-normal + 1px;
                                        font-family: "monospace";
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        ActionButton {
                                            text: @tr("Kopieren");
                                            clicked => { SettingsState.sync-action("copy-recovery"); }
                                        }
                                        ActionButton {
                                            text: @tr("Ausblenden");
                                            clicked => { SettingsState.sync-action("hide-recovery"); }
                                        }
                                    }
                                }
                            }
                            SettingRow {
                                title: @tr("Abgleich");
                                description: SettingsState.sync-status;
                                if SettingsState.sync-choice-pending : ActionButton {
                                    text: @tr("Entscheiden");
                                    kind: ButtonKind.primary;
                                    clicked => { SettingsState.sync-action("choose"); }
                                }
                                if SettingsState.sync-running && !SettingsState.sync-choice-pending : ActionButton {
                                    text: @tr("Jetzt abgleichen");
                                    clicked => { SettingsState.sync-action("now"); }
                                }
                            }
                            VerticalLayout {
                                spacing: 8px;
                                padding-top: 4px;
                                padding-bottom: 8px;
                                Segmented {
                                    options: [@tr("Lesen & Schreiben"), @tr("Nur lesen"), @tr("Auf Abruf"), @tr("Aus")];
                                    selected <=> SettingsState.sync-mode;
                                    changed-by-user => { SettingsState.changed("sync-mode"); }
                                }
                                Text {
                                    text: SettingsState.sync-mode == 0
                                        ? @tr("Änderungen hier gehen an den Server, Änderungen anderer Geräte kommen hierher.")
                                        : SettingsState.sync-mode == 1
                                        ? @tr("Dieses Gerät zeigt immer den Stand des Servers. Was du hier änderst, wird beim nächsten Abgleich verworfen.")
                                        : SettingsState.sync-mode == 2
                                        ? @tr("Wie „Nur lesen“, aber der Stand des Servers wird nur geholt, wenn du es sagst.")
                                        : @tr("Dieses Gerät bleibt angemeldet, gleicht aber nichts ab.");
                                    color: Theme.text-faint;
                                    font-size: Theme.font-small + 1px;
                                    wrap: word-wrap;
                                }
                            }
                            if SettingsState.sync-running : SettingRow {
                                title: @tr("Vom Server holen");
                                description: @tr("Ersetzt Workspaces, Inseln, Tabs und Archiv hier durch den Stand des Servers.");
                                ActionButton {
                                    text: @tr("Holen");
                                    clicked => { SettingsState.sync-action("mirror"); }
                                }
                            }
                            Divider { }
                            SectionTitle { text: @tr("GERÄTE"); }
                            VerticalLayout {
                                spacing: 6px;
                                padding-top: 4px;
                                padding-bottom: 8px;
                                TextField {
                                    text <=> SettingsState.sync-device-name;
                                    placeholder: @tr("Name dieses Geräts");
                                    accepted => { SettingsState.changed("sync-device-name-done"); }
                                    edited => { SettingsState.changed("sync-device-name"); }
                                }
                            }
                            for device in SettingsState.sync-devices : SettingRow {
                                title: device.name;
                                description: device.detail;
                                if !device.current : ActionButton {
                                    text: @tr("Entfernen");
                                    clicked => { SettingsState.sync-forget-device(device.id); }
                                }
                            }
                            Divider { }
                            SectionTitle { text: @tr("SCHLÜSSEL"); }
                            SettingRow {
                                title: @tr("Passphrase ändern");
                                description: @tr("Die anderen Geräte bleiben entsperrt; neue fragen nach der neuen Passphrase.");
                                ActionButton {
                                    text: SettingsState.sync-changing-passphrase ? @tr("Abbrechen") : @tr("Ändern");
                                    clicked => { SettingsState.sync-changing-passphrase = !SettingsState.sync-changing-passphrase; }
                                }
                            }
                            if SettingsState.sync-changing-passphrase : VerticalLayout {
                                spacing: 8px;
                                padding-bottom: 8px;
                                TextField {
                                    text <=> SettingsState.sync-passphrase;
                                    secret: true;
                                    placeholder: @tr("Neue Passphrase");
                                }
                                TextField {
                                    text <=> SettingsState.sync-passphrase-repeat;
                                    secret: true;
                                    placeholder: @tr("Neue Passphrase wiederholen");
                                    accepted => { SettingsState.sync-action("change-passphrase"); }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    ActionButton {
                                        text: @tr("Speichern");
                                        kind: ButtonKind.primary;
                                        clicked => { SettingsState.sync-action("change-passphrase"); }
                                    }
                                }
                            }
                            SettingRow {
                                title: @tr("Wiederherstellungsschlüssel");
                                description: @tr("Öffnet deine Daten, wenn die Passphrase vergessen ist.");
                                ActionButton {
                                    text: @tr("Anzeigen");
                                    clicked => { SettingsState.sync-action("show-recovery"); }
                                }
                            }
                            SettingRow {
                                title: @tr("Sync zurücksetzen");
                                description: @tr("Löscht alles, was der Server für dein Konto speichert. Was auf deinen Geräten liegt, bleibt.");
                                ActionButton {
                                    text: @tr("Zurücksetzen");
                                    kind: ButtonKind.danger;
                                    clicked => { SettingsState.sync-action("reset"); }
                                }
                            }
                        }
                        if SettingsState.sync-key-error != "" : Text {
                            text: SettingsState.sync-key-error;
                            color: Theme.danger;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("SERVER"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        if SettingsState.account-phase == 0 : TextField {
                            text <=> SettingsState.sync-server;
                            placeholder: "https://atoll.dasdarki.de";
                            edited => { SettingsState.changed("sync-server"); }
                            accepted => { SettingsState.changed("sync-server"); }
                        }
                        if SettingsState.account-phase != 0 : Text {
                            text: SettingsState.sync-server;
                            color: Theme.text;
                            font-size: Theme.font-normal;
                        }
                        Text {
                            text: @tr("Der Server speichert nur, was er nicht lesen kann. Angemeldet wird über das Onyx, das er nennt. Ändern lässt sich die Adresse nur abgemeldet.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        ActionButton {
            text: @tr("Fertig");
            kind: ButtonKind.primary;
            clicked => { SettingsState.close(); }
        }
    }
}

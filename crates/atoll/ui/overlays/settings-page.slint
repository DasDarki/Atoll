import { ComboBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserState, SettingsState } from "../state.slint";
import { Modal } from "modal.slint";
import { ActionButton, ButtonKind } from "../widgets/button.slint";
import { TextField } from "../widgets/text-field.slint";
import { FieldLabel } from "../widgets/field-label.slint";
import { Toggle } from "../widgets/toggle.slint";
import { Segmented } from "../widgets/segmented.slint";
import { PluginItem } from "../structs.slint";

component SectionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.text : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: Theme.font-normal;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.text-faint;
                font-size: Theme.font-small + 1px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 6px;
    padding-bottom: 4px;
    FieldLabel { text: root.text; }
}

export component SettingsPage inherits Modal {
    title: @tr("Einstellungen");
    card-width: 780px;
    dismissed => { SettingsState.close(); }

    HorizontalLayout {
        height: min(500px, root.height - 180px);
        spacing: 18px;

        VerticalLayout {
            width: 178px;
            spacing: 2px;
            alignment: start;

            SectionButton {
                text: @tr("Allgemein");
                icon: @image-url("../icons/settings.svg");
                selected: SettingsState.section == 0;
                clicked => { SettingsState.section = 0; }
            }
            SectionButton {
                text: @tr("Darstellung");
                icon: @image-url("../icons/layout.svg");
                selected: SettingsState.section == 1;
                clicked => { SettingsState.section = 1; }
            }
            SectionButton {
                text: @tr("Tabs");
                icon: @image-url("../icons/tab.svg");
                selected: SettingsState.section == 2;
                clicked => { SettingsState.section = 2; }
            }
            SectionButton {
                text: @tr("Downloads");
                icon: @image-url("../icons/download.svg");
                selected: SettingsState.section == 3;
                clicked => { SettingsState.section = 3; }
            }
            SectionButton {
                text: @tr("Datenschutz");
                icon: @image-url("../icons/shield.svg");
                selected: SettingsState.section == 4;
                clicked => { SettingsState.section = 4; }
            }
            SectionButton {
                text: @tr("Erweiterungen");
                icon: @image-url("../icons/layers.svg");
                selected: SettingsState.section == 5;
                clicked => { SettingsState.section = 5; }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        ScrollView {
            horizontal-stretch: 1;
            content-width: self.visible-width;

            VerticalLayout {
                padding-right: 14px;
                alignment: start;

                if SettingsState.section == 0 : VerticalLayout {
                    SectionTitle { text: @tr("STARTSEITE"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> SettingsState.start-page;
                                placeholder: @tr("Leer lassen für die Atoll-Startseite");
                                edited => { SettingsState.changed("start-page"); }
                                accepted => { SettingsState.changed("start-page"); }
                            }
                            ActionButton {
                                text: @tr("Aktuelle Seite");
                                enabled: BrowserState.has-page;
                                clicked => { SettingsState.use-current-page(); }
                            }
                        }
                        Text {
                            text: @tr("Wird vom Startseiten-Button und mit Alt+Pos1 geöffnet.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Neue Tabs mit der Startseite öffnen");
                        description: SettingsState.start-page == "" ? @tr("Dafür zuerst eine Startseite eintragen.") : @tr("Sonst zeigen neue Tabs die Atoll-Startseite mit der Suche.");
                        Toggle {
                            enabled: SettingsState.start-page != "";
                            checked <=> SettingsState.new-tab-start-page;
                            toggled => { SettingsState.changed("new-tab-start-page"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Startseiten-Button in der Symbolleiste");
                        Toggle {
                            checked <=> SettingsState.home-button;
                            toggled => { SettingsState.changed("home-button"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("SUCHMASCHINE"); }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        ComboBox {
                            model: SettingsState.search-engines;
                            current-index <=> SettingsState.search-engine;
                            selected => { SettingsState.changed("search-engine"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : TextField {
                            text <=> SettingsState.search-url;
                            placeholder: "https://example.org/search?q={query}";
                            edited => { SettingsState.changed("search-url"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : Text {
                            text: SettingsState.search-url-valid ? @tr("{{query}} wird durch den Suchbegriff ersetzt.") : @tr("Die Adresse muss {{query}} enthalten, bis dahin bleibt die bisherige Suche aktiv.");
                            color: SettingsState.search-url-valid ? Theme.text-faint : Theme.danger;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    SectionTitle { text: @tr("SPRACHE"); }
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        ComboBox {
                            model: SettingsState.languages;
                            current-index <=> SettingsState.language;
                            selected => { SettingsState.changed("language"); }
                        }
                        Text {
                            text: @tr("Gilt sofort, ohne Neustart.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                }

                if SettingsState.section == 1 : VerticalLayout {
                    SettingRow {
                        title: @tr("Sidebar anzeigen");
                        description: @tr("Strg+B blendet sie jederzeit ein oder aus.");
                        Toggle {
                            checked <=> SettingsState.sidebar-visible;
                            toggled => { SettingsState.changed("sidebar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lesezeichenleiste anzeigen");
                        description: @tr("Strg+Umschalt+B blendet sie jederzeit ein oder aus.");
                        Toggle {
                            checked <=> SettingsState.bookmarks-bar-visible;
                            toggled => { SettingsState.changed("bookmarks-bar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Lesezeichenleiste nur mit Lesezeichen anzeigen");
                        description: @tr("Blendet die Leiste aus, solange sie leer ist.");
                        Toggle {
                            enabled: SettingsState.bookmarks-bar-visible;
                            checked <=> SettingsState.bookmarks-bar-auto-hide;
                            toggled => { SettingsState.changed("bookmarks-bar-auto-hide"); }
                        }
                    }
                }

                if SettingsState.section == 2 : VerticalLayout {
                    SettingRow {
                        title: @tr("Eingefrorene Tabs im Hintergrund");
                        description: @tr("So viele zuletzt genutzte Tabs bleiben geladen und erscheinen sofort. Alle anderen schlafen und kosten keinen Arbeitsspeicher.");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-frozen-limit;
                            value <=> SettingsState.frozen-limit;
                            edited => { SettingsState.changed("frozen-limit"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Arbeitsspeicher begrenzen");
                        description: @tr("Belegen die Seiten mehr als das Budget, schlafen die am längsten nicht genutzten Hintergrund-Tabs ein. Tabs mit Wiedergabe, ungesendeten Eingaben und angepinnte Tabs bleiben geladen. ") + SettingsState.memory-usage;
                        Toggle {
                            checked <=> SettingsState.memory-limit-enabled;
                            toggled => { SettingsState.changed("memory-limit"); }
                        }
                    }
                    SettingRow {
                        title: @tr("Budget in GB");
                        SpinBox {
                            width: 110px;
                            enabled: SettingsState.memory-limit-enabled;
                            minimum: 1;
                            maximum: SettingsState.max-memory-limit-gb;
                            value <=> SettingsState.memory-limit-gb;
                            edited => { SettingsState.changed("memory-limit"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Archivierung vorschlagen nach Wochen");
                        description: @tr("Inseln, die so lange nicht benutzt wurden, werden in der Sidebar markiert und im Archiv vorgeschlagen. Archiviert wird nur nach deiner Bestätigung. 0 schaltet die Vorschläge aus.");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-archive-suggestion-weeks;
                            value <=> SettingsState.archive-suggestion-weeks;
                            edited => { SettingsState.changed("archive-suggestion-weeks"); }
                        }
                    }
                }

                if SettingsState.section == 3 : VerticalLayout {
                    SectionTitle { text: @tr("SPEICHERORT"); }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: Theme.radius;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: SettingsState.download-directory;
                                color: Theme.text;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if SettingsState.download-directory-custom : ActionButton {
                            text: @tr("Standard");
                            clicked => { SettingsState.reset-download-directory(); }
                        }
                        ActionButton {
                            text: @tr("Ändern…");
                            clicked => { SettingsState.choose-download-directory(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Vor jedem Download nach dem Speicherort fragen");
                        description: @tr("Zeigt einen Speichern-Dialog, statt direkt im Download-Ordner zu speichern.");
                        Toggle {
                            checked <=> SettingsState.download-ask;
                            toggled => { SettingsState.changed("download-ask"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Download-Übersicht beim Start eines Downloads öffnen");
                        description: @tr("Sonst erscheint nur eine kurze Meldung. Die Übersicht öffnet Strg+J.");
                        Toggle {
                            checked <=> SettingsState.download-panel;
                            toggled => { SettingsState.changed("download-panel"); }
                        }
                    }
                }

                if SettingsState.section == 4 : VerticalLayout {
                    SectionTitle { text: @tr("WERBEBLOCKER"); }
                    SettingRow {
                        title: @tr("Werbung und Tracker blockieren");
                        description: SettingsState.adblock-status;
                        Toggle {
                            checked <=> SettingsState.adblock-enabled;
                            toggled => { SettingsState.changed("adblock-enabled"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Filterlisten aktualisieren");
                        description: @tr("Geschieht automatisch alle vier Tage.");
                        ActionButton {
                            text: @tr("Jetzt aktualisieren");
                            enabled: !SettingsState.adblock-updating;
                            clicked => { SettingsState.update-filter-lists(); }
                        }
                    }
                    if SettingsState.adblock-exceptions != "" : Divider { }
                    if SettingsState.adblock-exceptions != "" : SettingRow {
                        title: @tr("Ausgeschaltet auf");
                        description: SettingsState.adblock-exceptions;
                        ActionButton {
                            text: @tr("Alle entfernen");
                            clicked => { SettingsState.clear-adblock-exceptions(); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: "1PASSWORD"; }
                    SettingRow {
                        title: @tr("Anmeldungen mit 1Password ausfüllen");
                        description: SettingsState.onepassword-status;
                    }
                    Divider { }
                    SectionTitle { text: @tr("SEITEN, DIE ES NICHT MEHR GIBT"); }
                    VerticalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        Segmented {
                            options: [@tr("Aus"), @tr("Fragen"), @tr("Automatisch")];
                            selected <=> SettingsState.archive-fallback;
                            changed-by-user => { SettingsState.changed("archive-fallback"); }
                        }
                        Text {
                            text: @tr("Ist eine Seite nicht erreichbar, fragt Atoll das Internet Archive nach einer Kopie. Dabei wandert die Adresse der Seite dorthin. In privaten Tabs passiert das nie.");
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    if SettingsState.archive-fallback != 0 : SettingRow {
                        title: @tr("Auch wenn die Seite „nicht gefunden“ meldet");
                        description: @tr("Sonst nur, wenn die Seite gar nicht antwortet.");
                        Toggle {
                            checked <=> SettingsState.archive-on-missing;
                            toggled => { SettingsState.changed("archive-on-missing"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: @tr("DATEN"); }
                    SettingRow {
                        title: @tr("Verlauf löschen");
                        description: @tr("Entfernt alle besuchten Seiten. Tabs, Inseln und Lesezeichen bleiben erhalten.");
                        ActionButton {
                            text: @tr("Löschen");
                            clicked => { SettingsState.clear-history(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Cookies löschen");
                        description: @tr("Meldet dich auf allen Websites ab.");
                        ActionButton {
                            text: @tr("Löschen");
                            clicked => { SettingsState.clear-cookies(); }
                        }
                    }
                }

                if SettingsState.section == 5 : VerticalLayout {
                    SectionTitle { text: @tr("ERWEITERUNGEN"); }
                    if SettingsState.plugins.length == 0 : SettingRow {
                        title: @tr("Keine Erweiterungen installiert");
                        description: @tr("Installiere eine aus einem Archiv oder aus Git, oder lege einen Ordner mit einer plugin.toml an.");
                    }
                    for plugin[index] in SettingsState.plugins : VerticalLayout {
                        if index > 0 : Divider { }
                        SettingRow {
                            title: plugin.name + " " + plugin.version;
                            description: plugin.detail;
                            Toggle {
                                checked: plugin.enabled;
                                toggled => { SettingsState.plugin-action(plugin.id, self.checked ? "enable" : "disable"); }
                            }
                        }
                        if plugin.permissions != "" : Text {
                            text: plugin.permissions;
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        if plugin.status != "" : Text {
                            text: plugin.status;
                            color: plugin.failed ? Theme.danger : Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                        if plugin.source != "" : Text {
                            text: plugin.source;
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            alignment: start;
                            ActionButton {
                                text: @tr("Neu laden");
                                clicked => { SettingsState.plugin-action(plugin.id, "reload"); }
                            }
                            if plugin.from-git : ActionButton {
                                text: @tr("Aktualisieren");
                                clicked => { SettingsState.plugin-action(plugin.id, "update"); }
                            }
                            ActionButton {
                                text: @tr("Protokoll");
                                clicked => { SettingsState.plugin-action(plugin.id, "log"); }
                            }
                            ActionButton {
                                text: @tr("Entfernen");
                                clicked => { SettingsState.plugin-action(plugin.id, "remove"); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Erweiterung installieren");
                        description: @tr("Aus einem Zip-Archiv oder aus einem Git-Repository. Atoll fragt danach, was die Erweiterung darf.");
                        ActionButton {
                            text: @tr("Aus Archiv");
                            clicked => { SettingsState.install-plugin("archive"); }
                        }
                        ActionButton {
                            text: @tr("Aus Git");
                            clicked => { SettingsState.install-plugin("git"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Ordner der Erweiterungen");
                        description: SettingsState.plugin-directory;
                        ActionButton {
                            text: @tr("Öffnen");
                            clicked => { SettingsState.open-plugin-folder(); }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        ActionButton {
            text: @tr("Fertig");
            kind: ButtonKind.primary;
            clicked => { SettingsState.close(); }
        }
    }
}

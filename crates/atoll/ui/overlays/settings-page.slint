import { ComboBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserState, SettingsState } from "../state.slint";
import { Modal } from "modal.slint";
import { ActionButton, ButtonKind } from "../widgets/button.slint";
import { TextField } from "../widgets/text-field.slint";
import { FieldLabel } from "../widgets/field-label.slint";
import { Toggle } from "../widgets/toggle.slint";

component SectionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.text : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: Theme.font-normal;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-normal;
                wrap: word-wrap;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.text-faint;
                font-size: Theme.font-small + 1px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component SectionTitle inherits VerticalLayout {
    in property <string> text;
    padding-top: 6px;
    padding-bottom: 4px;
    FieldLabel { text: root.text; }
}

export component SettingsPage inherits Modal {
    title: "Einstellungen";
    card-width: 780px;
    dismissed => { SettingsState.close(); }

    HorizontalLayout {
        height: min(500px, root.height - 180px);
        spacing: 18px;

        VerticalLayout {
            width: 178px;
            spacing: 2px;
            alignment: start;

            SectionButton {
                text: "Allgemein";
                icon: @image-url("../icons/settings.svg");
                selected: SettingsState.section == 0;
                clicked => { SettingsState.section = 0; }
            }
            SectionButton {
                text: "Darstellung";
                icon: @image-url("../icons/layout.svg");
                selected: SettingsState.section == 1;
                clicked => { SettingsState.section = 1; }
            }
            SectionButton {
                text: "Tabs";
                icon: @image-url("../icons/tab.svg");
                selected: SettingsState.section == 2;
                clicked => { SettingsState.section = 2; }
            }
            SectionButton {
                text: "Datenschutz";
                icon: @image-url("../icons/shield.svg");
                selected: SettingsState.section == 3;
                clicked => { SettingsState.section = 3; }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        ScrollView {
            horizontal-stretch: 1;
            content-width: self.visible-width;

            VerticalLayout {
                padding-right: 14px;
                alignment: start;

                if SettingsState.section == 0 : VerticalLayout {
                    SectionTitle { text: "STARTSEITE"; }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> SettingsState.start-page;
                                placeholder: "Leer lassen für die Atoll-Startseite";
                                edited => { SettingsState.changed("start-page"); }
                                accepted => { SettingsState.changed("start-page"); }
                            }
                            ActionButton {
                                text: "Aktuelle Seite";
                                enabled: BrowserState.has-page;
                                clicked => { SettingsState.use-current-page(); }
                            }
                        }
                        Text {
                            text: "Wird vom Startseiten-Button und mit Alt+Pos1 geöffnet.";
                            color: Theme.text-faint;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Neue Tabs mit der Startseite öffnen";
                        description: SettingsState.start-page == "" ? "Dafür zuerst eine Startseite eintragen." : "Sonst zeigen neue Tabs die Atoll-Startseite mit der Suche.";
                        Toggle {
                            enabled: SettingsState.start-page != "";
                            checked <=> SettingsState.new-tab-start-page;
                            toggled => { SettingsState.changed("new-tab-start-page"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Startseiten-Button in der Symbolleiste";
                        Toggle {
                            checked <=> SettingsState.home-button;
                            toggled => { SettingsState.changed("home-button"); }
                        }
                    }
                    Divider { }
                    SectionTitle { text: "SUCHMASCHINE"; }
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        ComboBox {
                            model: SettingsState.search-engines;
                            current-index <=> SettingsState.search-engine;
                            selected => { SettingsState.changed("search-engine"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : TextField {
                            text <=> SettingsState.search-url;
                            placeholder: "https://example.org/search?q={query}";
                            edited => { SettingsState.changed("search-url"); }
                        }
                        if SettingsState.search-engine == SettingsState.search-engines.length - 1 : Text {
                            text: SettingsState.search-url-valid ? "{query} wird durch den Suchbegriff ersetzt." : "Die Adresse muss {query} enthalten, bis dahin bleibt die bisherige Suche aktiv.";
                            color: SettingsState.search-url-valid ? Theme.text-faint : Theme.danger;
                            font-size: Theme.font-small + 1px;
                            wrap: word-wrap;
                        }
                    }
                }

                if SettingsState.section == 1 : VerticalLayout {
                    SettingRow {
                        title: "Sidebar anzeigen";
                        description: "Strg+B blendet sie jederzeit ein oder aus.";
                        Toggle {
                            checked <=> SettingsState.sidebar-visible;
                            toggled => { SettingsState.changed("sidebar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Lesezeichenleiste anzeigen";
                        description: "Strg+Umschalt+B blendet sie jederzeit ein oder aus.";
                        Toggle {
                            checked <=> SettingsState.bookmarks-bar-visible;
                            toggled => { SettingsState.changed("bookmarks-bar-visible"); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Lesezeichenleiste nur mit Lesezeichen anzeigen";
                        description: "Blendet die Leiste aus, solange sie leer ist.";
                        Toggle {
                            enabled: SettingsState.bookmarks-bar-visible;
                            checked <=> SettingsState.bookmarks-bar-auto-hide;
                            toggled => { SettingsState.changed("bookmarks-bar-auto-hide"); }
                        }
                    }
                }

                if SettingsState.section == 2 : VerticalLayout {
                    SettingRow {
                        title: "Eingefrorene Tabs im Hintergrund";
                        description: "So viele zuletzt genutzte Tabs bleiben geladen und erscheinen sofort. Alle anderen schlafen und kosten keinen Arbeitsspeicher.";
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: SettingsState.max-frozen-limit;
                            value <=> SettingsState.frozen-limit;
                            edited => { SettingsState.changed("frozen-limit"); }
                        }
                    }
                }

                if SettingsState.section == 3 : VerticalLayout {
                    SettingRow {
                        title: "Verlauf löschen";
                        description: "Entfernt alle besuchten Seiten. Tabs, Inseln und Lesezeichen bleiben erhalten.";
                        ActionButton {
                            text: "Löschen";
                            clicked => { SettingsState.clear-history(); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Cookies löschen";
                        description: "Meldet dich auf allen Websites ab.";
                        ActionButton {
                            text: "Löschen";
                            clicked => { SettingsState.clear-cookies(); }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        ActionButton {
            text: "Fertig";
            kind: ButtonKind.primary;
            clicked => { SettingsState.close(); }
        }
    }
}

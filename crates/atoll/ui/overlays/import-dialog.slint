import { TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { OverlayState } from "../state.slint";
import { Modal } from "modal.slint";
import { ActionButton, ButtonKind } from "../widgets/button.slint";
import { Segmented } from "../widgets/segmented.slint";
import { TextField } from "../widgets/text-field.slint";
import { FieldLabel } from "../widgets/field-label.slint";

export component ImportDialog inherits Modal {
    title: @tr("URL-Liste importieren");
    card-width: 640px;
    autofocus: false;
    dismissed => { OverlayState.import-cancel(); }

    init => { editor.focus(); }

    HorizontalLayout {
        spacing: 8px;
        ActionButton {
            text: @tr("Datei wählen…");
            clicked => { OverlayState.import-choose-file(); }
        }
        ActionButton {
            text: @tr("Aus Zwischenablage einfügen");
            clicked => { OverlayState.import-paste(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    editor := TextEdit {
        height: 190px;
        font-size: Theme.font-normal;
        text <=> OverlayState.import-text;
        placeholder-text: @tr("--- Inselname ---\nhttps://example.com\n\n# Kommentare werden ignoriert");
        edited(text) => { OverlayState.import-text-edited(text); }
    }

    Text {
        text: OverlayState.import-summary;
        color: OverlayState.import-ready ? Theme.accent-cyan : Theme.text-faint;
        font-size: Theme.font-normal;
        wrap: word-wrap;
    }

    VerticalLayout {
        spacing: 6px;
        FieldLabel { text: @tr("ZIEL"); }
        Segmented {
            options: [@tr("Aktueller Workspace"), @tr("Neuer Workspace")];
            selected <=> OverlayState.import-target;
        }
        if OverlayState.import-target == 1 : TextField {
            text <=> OverlayState.import-workspace-name;
            placeholder: @tr("Name des neuen Workspaces");
        }
    }

    VerticalLayout {
        spacing: 6px;
        FieldLabel { text: @tr("DUPLIKATE"); }
        Segmented {
            options: [@tr("Behalten"), @tr("Überspringen"), @tr("Zusammenführen")];
            selected <=> OverlayState.import-duplicates;
            changed-by-user => { OverlayState.import-text-edited(OverlayState.import-text); }
        }
    }

    VerticalLayout {
        spacing: 6px;
        FieldLabel { text: @tr("GLEICHNAMIGE INSELN"); }
        Segmented {
            options: [@tr("Zusammenführen"), @tr("Als neue Insel anlegen")];
            selected <=> OverlayState.import-islands;
            changed-by-user => { OverlayState.import-text-edited(OverlayState.import-text); }
        }
    }

    VerticalLayout {
        spacing: 6px;
        FieldLabel { text: @tr("INSELNAMEN"); }
        Segmented {
            options: [@tr("Aus der Liste"), @tr("Durchnummerieren")];
            selected <=> OverlayState.import-naming;
            changed-by-user => { OverlayState.import-text-edited(OverlayState.import-text); }
        }
    }

    if OverlayState.import-naming == 0 : VerticalLayout {
        spacing: 6px;
        FieldLabel { text: @tr("INSEL FÜR ADRESSEN OHNE MARKIERUNG"); }
        TextField {
            text <=> OverlayState.import-fallback;
            placeholder: @tr("Importiert");
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        ActionButton {
            text: @tr("Abbrechen");
            clicked => { OverlayState.import-cancel(); }
        }
        ActionButton {
            text: @tr("Importieren");
            kind: ButtonKind.primary;
            enabled: OverlayState.import-ready;
            clicked => { OverlayState.import-confirm(); }
        }
    }
}

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { OverlayState } from "../state.slint";
import { DownloadItem, DownloadItemStatus } from "../structs.slint";
import { IconButton } from "../widgets/icon-button.slint";

component TextButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 28px;
    width: label.preferred-width + 20px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;

    label := Text {
        text: root.text;
        color: Theme.accent;
        font-size: Theme.font-small + 1px;
        font-weight: 600;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DownloadRow inherits Rectangle {
    in property <DownloadItem> item;

    property <bool> active: root.item.status == DownloadItemStatus.running || root.item.status == DownloadItemStatus.paused;
    property <bool> openable: root.item.status == DownloadItemStatus.complete;

    height: 58px;
    border-radius: Theme.radius-small;
    background: touch.has-hover && root.openable ? Theme.hover : transparent;

    touch := TouchArea {
        mouse-cursor: root.openable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.openable) {
                OverlayState.download-action(root.item.id, "open");
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 10px;

        Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-small;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../icons/file.svg");
                colorize: root.item.status == DownloadItemStatus.complete ? Theme.accent-cyan
                    : root.item.status == DownloadItemStatus.failed ? Theme.danger
                    : Theme.text-faint;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.item.file-name;
                color: root.item.status == DownloadItemStatus.complete || root.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-normal;
                overflow: elide;
            }

            if root.active : Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Theme.border-strong;
                Rectangle {
                    x: 0;
                    width: root.item.progress < 0 ? parent.width * 0.3 : parent.width * root.item.progress;
                    border-radius: 1.5px;
                    background: root.item.status == DownloadItemStatus.paused ? Theme.text-faint : Theme.accent-cyan;
                }
            }

            Text {
                text: root.item.detail;
                color: root.item.status == DownloadItemStatus.failed ? Theme.danger : Theme.text-faint;
                font-size: Theme.font-small + 1px;
                overflow: elide;
            }
        }

        if root.item.status == DownloadItemStatus.running && root.item.can-pause : IconButton {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/pause.svg");
            clicked => { OverlayState.download-action(root.item.id, "pause"); }
        }
        if root.item.status == DownloadItemStatus.paused : IconButton {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/play.svg");
            clicked => { OverlayState.download-action(root.item.id, "resume"); }
        }
        if root.item.status == DownloadItemStatus.complete : IconButton {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/folder.svg");
            clicked => { OverlayState.download-action(root.item.id, "show"); }
        }
        if root.item.status == DownloadItemStatus.canceled || root.item.status == DownloadItemStatus.failed : IconButton {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/reload.svg");
            clicked => { OverlayState.download-action(root.item.id, "retry"); }
        }
        IconButton {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            icon-size: 14px;
            icon: @image-url("../icons/close.svg");
            clicked => { OverlayState.download-action(root.item.id, root.active ? "cancel" : "remove"); }
        }
    }
}

export component DownloadsPanel inherits Rectangle {
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                OverlayState.downloads-close();
            }
        }
    }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                OverlayState.downloads-close();
            }
            return accept;
        }
    }

    card := Rectangle {
        x: root.width - self.width - 10px;
        y: Theme.toolbar-height + 2px;
        width: 400px;
        height: min(layout.preferred-height, root.height - self.y - 12px);
        border-radius: Theme.radius;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000a8;
        clip: true;

        TouchArea { }

        layout := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            HorizontalLayout {
                padding-left: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;
                Text {
                    text: "Downloads";
                    color: Theme.text;
                    font-size: Theme.font-large;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if OverlayState.downloads-clearable : TextButton {
                    text: "Liste leeren";
                    clicked => { OverlayState.downloads-clear(); }
                }
                TextButton {
                    text: "Ordner öffnen";
                    clicked => { OverlayState.downloads-open-folder(); }
                }
            }

            if OverlayState.download-items.length == 0 : Text {
                height: 64px;
                text: "Noch keine Downloads.";
                color: Theme.text-faint;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if OverlayState.download-items.length > 0 : ScrollView {
                height: min(OverlayState.download-items.length * 58px, 406px);
                content-width: self.visible-width;

                VerticalLayout {
                    alignment: start;
                    for item in OverlayState.download-items : DownloadRow {
                        item: item;
                    }
                }
            }
        }
    }
}
